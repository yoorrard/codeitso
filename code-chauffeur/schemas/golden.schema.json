{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "golden.schema.json",
  "title": "추천 회귀 검사 사례 (골든 케이스)",
  "description": "인터뷰 답과 최종 장바구니를 넣으면 엔진이 내야 하는 결과. 규칙·가중치·상품을 바꾸면 이 사례들이 그대로 통과해야 한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "answers", "cart", "expect"],
  "properties": {
    "id": { "type": "string", "pattern": "^case-[0-9]{2}$" },
    "title": { "$ref": "defs.schema.json#/$defs/nonEmptyText" },
    "note": { "type": "string" },
    "answers": {
      "type": "object",
      "propertyNames": { "$ref": "defs.schema.json#/$defs/questionId" },
      "additionalProperties": { "$ref": "defs.schema.json#/$defs/id" }
    },
    "cart": {
      "type": "array",
      "items": { "$ref": "defs.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "kept": {
      "type": "array",
      "items": { "$ref": "defs.schema.json#/$defs/conflictId" },
      "uniqueItems": true
    },
    "deferred": {
      "type": "array",
      "items": { "$ref": "defs.schema.json#/$defs/slotId" },
      "uniqueItems": true,
      "description": "1차/2차 나누기에서 2차로 미룬 칸"
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asked", "slots", "conflicts", "canIssue", "research", "safety", "study", "difficulty", "split"],
      "properties": {
        "asked": {
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/questionId" },
          "description": "실제로 물어본 질문 (순서대로)"
        },
        "tags": {
          "type": "object",
          "propertyNames": { "$ref": "defs.schema.json#/$defs/tagId" },
          "additionalProperties": { "type": "number" },
          "description": "적은 태그만 비교한다"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "required", "recommended", "filledBy"],
            "properties": {
              "id": { "$ref": "defs.schema.json#/$defs/slotId" },
              "required": { "type": "boolean" },
              "recommended": {
                "anyOf": [
                  { "$ref": "defs.schema.json#/$defs/id" },
                  { "type": "null" }
                ]
              },
              "score": { "type": "number", "description": "추천 상품의 점수" },
              "runnerUp": {
                "anyOf": [
                  { "$ref": "defs.schema.json#/$defs/id" },
                  { "type": "null" }
                ]
              },
              "reasons": {
                "type": "array",
                "items": { "type": "string" },
                "description": "추천 이유 키 (순서대로)"
              },
              "filledBy": {
                "type": "array",
                "items": { "$ref": "defs.schema.json#/$defs/id" }
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/conflictId" }
        },
        "canIssue": { "type": "boolean" },
        "research": {
          "type": "array",
          "items": { "type": "string" },
          "description": "조사할 것 id (순서대로)"
        },
        "safety": {
          "type": "array",
          "items": { "type": "string" },
          "description": "켜진 안전 규칙 id (기본 지시 제외)"
        },
        "study": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "all"],
          "properties": {
            "required": {
              "type": "array",
              "items": { "$ref": "defs.schema.json#/$defs/id" }
            },
            "all": {
              "type": "array",
              "items": { "$ref": "defs.schema.json#/$defs/id" }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "진행 순서 단계 id (칸 id 또는 step.proxy)"
        },
        "prep": {
          "type": "array",
          "items": { "type": "string" },
          "description": "준비물 이름 (순서대로)"
        },
        "difficulty": { "type": "integer" },
        "difficultyFirst": { "type": "integer", "description": "2차로 미룬 칸에만 쓰이는 상품을 뺀 난이도" },
        "minutes": { "type": "integer" },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["needed", "defer"],
          "properties": {
            "needed": { "type": "boolean" },
            "defer": {
              "type": "array",
              "items": { "$ref": "defs.schema.json#/$defs/slotId" }
            },
            "easier": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["slotId", "from", "to"],
                "properties": {
                  "slotId": { "$ref": "defs.schema.json#/$defs/slotId" },
                  "from": { "$ref": "defs.schema.json#/$defs/id" },
                  "to": { "$ref": "defs.schema.json#/$defs/id" }
                }
              }
            }
          }
        }
      }
    }
  }
}
