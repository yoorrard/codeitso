{
  "version": 1,
  "rules": [
    {
      "id": "slot-rule.screen",
      "type": "slot",
      "when": { "always": true },
      "slot": {
        "id": "slot.screen",
        "label": "화면",
        "capability": "screen",
        "required": true,
        "order": 10,
        "mustFill": true,
        "help": "앱의 겉모습. 모든 앱에 하나는 꼭 있어야 해요.",
        "emptyFix": "추천 도구를 하나 고르세요."
      }
    },
    {
      "id": "slot-rule.store",
      "type": "slot",
      "when": { "tag": "need.save", "gte": 1 },
      "slot": {
        "id": "slot.store",
        "label": "저장",
        "capability": "store",
        "required": true,
        "order": 20,
        "help": "입력한 내용을 남겨 두는 곳"
      }
    },
    {
      "id": "slot-rule.auth",
      "type": "slot",
      "when": { "tag": "need.login", "gte": 1 },
      "slot": {
        "id": "slot.auth",
        "label": "로그인",
        "capability": "auth",
        "required": true,
        "order": 30,
        "help": "각자 자기 것만 보게 하는 기능",
        "deferrable": true,
        "emptyMessage": "로그인이 필요하다고 했는데, 고른 도구 중에 로그인 기능이 있는 것이 없어요.",
        "emptyFix": "로그인 기능도 있는 도구(예: Supabase)로 바꾸거나, '나중으로 미루기'를 누르세요."
      }
    },
    {
      "id": "slot-rule.data",
      "type": "slot",
      "when": { "tag": "need.data", "gte": 1 },
      "slot": {
        "id": "slot.data",
        "label": "외부 데이터",
        "capability": "data",
        "required": true,
        "order": 40,
        "help": "다른 곳에서 받아 오는 정보",
        "matchDomain": true,
        "emptyMessage": "가져올 정보를 줄 도구를 아직 고르지 않았어요.",
        "emptyFix": "맞는 도구가 없으면 '그대로 가기'를 누르세요. '알아볼 것'에 적어 두면 내 AI가 찾아 줄 거예요."
      }
    },
    {
      "id": "slot-rule.notify",
      "type": "slot",
      "when": { "tag": "need.notify", "gte": 1 },
      "slot": {
        "id": "slot.notify",
        "label": "알림",
        "capability": "notify",
        "required": true,
        "order": 45,
        "help": "조건이 맞으면 휴대폰으로 알려 주는 기능",
        "deferrable": true
      }
    },
    {
      "id": "slot-rule.host-shared",
      "type": "slot",
      "when": {
        "any": [
          { "tag": "audience.few", "gte": 1 },
          { "tag": "audience.public", "gte": 1 }
        ]
      },
      "note": "다른 사람이 쓰면 배포가 꼭 필요하다",
      "slot": {
        "id": "slot.host",
        "label": "배포·공유",
        "capability": "host",
        "required": true,
        "order": 50,
        "help": "다른 사람이 주소로 열 수 있게 올리는 곳"
      }
    },
    {
      "id": "slot-rule.host-me",
      "type": "slot",
      "when": { "tag": "audience.me", "gte": 1 },
      "note": "나만 쓰면 배포는 고를 수 있는 칸",
      "slot": {
        "id": "slot.host",
        "label": "배포·공유",
        "capability": "host",
        "required": false,
        "order": 50,
        "help": "다른 사람이 주소로 열 수 있게 올리는 곳"
      }
    },
    {
      "id": "conflict.paid-on-free",
      "type": "conflict",
      "when": {
        "all": [
          { "tag": "budget.free", "gte": 1 },
          {
            "cartAny": { "field": "cost.free", "is": false }
          }
        ]
      },
      "message": "0원만 쓰기로 했는데 유료 도구를 골랐어요.",
      "fixHint": "0원으로 시작하는 도구로 바꾸거나, 예산 답을 바꾸세요.",
      "researchCard": "research.paid-limits"
    },
    {
      "id": "conflict.realtime-mismatch",
      "type": "conflict",
      "when": {
        "all": [
          { "tag": "need.realtime", "gte": 1 },
          {
            "cartAny": { "capability": "data", "field": "realtime", "in": ["daily", "static"] }
          }
        ]
      },
      "message": "실시간이 필요하다고 했는데, 고른 도구의 데이터는 실시간으로 바뀌지 않아요.",
      "fixHint": "실시간 데이터를 주는 도구로 바꾸거나, 하루 단위로 충분한지 다시 생각해 보세요.",
      "researchCard": "research.realtime-source",
      "anchorSlot": "slot.data"
    },
    {
      "id": "conflict.personal-server",
      "type": "conflict",
      "when": {
        "all": [
          { "tag": "sensitive.personal", "gte": 1 },
          {
            "cartAny": { "capability": "store", "field": "serverRegion", "in": ["overseas", "selectable", "unknown"] }
          }
        ]
      },
      "message": "개인정보를 받는데, 저장에 쓸 도구의 서버가 해외에 있거나 서버 지역을 직접 골라야 해요.",
      "fixHint": "지역을 고를 수 있으면 서울(한국)을 고르세요. 아니면 받는 개인정보를 줄이거나, 학교·기관이 허용한 도구인지 확인하세요.",
      "researchCard": "research.privacy-overseas",
      "anchorSlot": "slot.store"
    },
    {
      "id": "conflict.key-in-static-page",
      "type": "conflict",
      "when": {
        "all": [
          {
            "cartAny": { "field": "keyExposureRisk", "is": true }
          },
          {
            "not": {
              "cartAny": { "capability": "proxy" }
            }
          },
          {
            "not": { "tag": "audience.me", "gte": 1 }
          }
        ]
      },
      "message": "키를 숨겨 줄 중간 서버가 없어서 API 키가 화면 코드에 그대로 드러나요. 브라우저에서 바로 부르면 CORS 때문에 막힐 수도 있어요.",
      "fixHint": "키를 숨겨 주는 중간 서버 기능이 있는 도구(예: Cloudflare Workers, 구글 시트 + 앱스 스크립트)를 배포·공유에 쓸 도구로 고르세요.",
      "researchCard": "research.key-hiding",
      "anchorSlot": "slot.host"
    },
    {
      "id": "conflict.key-on-public-host",
      "type": "conflict",
      "when": {
        "all": [
          { "tag": "audience.me", "gte": 1 },
          {
            "cartAny": { "capability": "data", "field": "keyExposureRisk", "is": true }
          },
          {
            "not": {
              "cartAny": { "capability": "proxy" }
            }
          },
          {
            "cartAny": { "capability": "host" }
          }
        ]
      },
      "note": "나만 쓰는 앱은 키 노출 충돌을 띄우지 않지만(D14), 중간 서버 없이 공개 주소에 올리면 키가 드러난다 (D36)",
      "message": "나만 쓰는 앱이어도, 키를 숨겨 줄 중간 서버 없이 공개 주소에 올리면 누구나 브라우저에서 API 키를 볼 수 있어요.",
      "fixHint": "배포·공유에 쓸 도구를 빼고 내 컴퓨터에서만 쓰거나, 키를 숨겨 주는 도구(예: 구글 시트 + 앱스 스크립트, Cloudflare Workers)를 고르세요.",
      "researchCard": "research.key-hiding",
      "anchorSlot": "slot.host"
    },
    {
      "id": "conflict.shared-without-login",
      "type": "conflict",
      "when": {
        "all": [
          { "tag": "sensitive.personal", "gte": 1 },
          {
            "any": [
              { "tag": "audience.few", "gte": 1 },
              { "tag": "audience.public", "gte": 1 }
            ]
          },
          {
            "not": { "tag": "need.login", "gte": 1 }
          },
          {
            "not": { "tag": "type.form", "gte": 1 }
          }
        ]
      },
      "note": "신청서는 응답을 화면에 보여 주지 않으므로 뺀다 (safety.form-responses)",
      "message": "개인정보를 받는데 로그인이 없어서, 주소를 아는 사람은 누구나 다른 사람의 기록을 볼 수 있어요.",
      "fixHint": "로그인 질문으로 돌아가 '네'를 고르거나, 개인정보를 받지 않게 바꾸세요.",
      "researchCard": "research.privacy-personal"
    },
    {
      "id": "research-rule.privacy-student",
      "type": "research",
      "when": { "tag": "sensitive.students", "gte": 1 },
      "card": "research.privacy-student"
    },
    {
      "id": "research-rule.privacy-personal",
      "type": "research",
      "when": {
        "all": [
          { "tag": "sensitive.personal", "gte": 1 },
          {
            "not": { "tag": "sensitive.students", "gte": 1 }
          }
        ]
      },
      "card": "research.privacy-personal"
    },
    {
      "id": "research-rule.payment",
      "type": "research",
      "when": { "tag": "sensitive.payment", "gte": 1 },
      "card": "research.payment"
    },
    {
      "id": "research-rule.finance-redistribution",
      "type": "research",
      "when": {
        "all": [
          { "tag": "domain.finance", "gte": 1 },
          {
            "not": { "tag": "audience.me", "gte": 1 }
          }
        ]
      },
      "card": "research.finance-redistribution"
    },
    {
      "id": "research-rule.finance-advice",
      "type": "research",
      "when": {
        "all": [
          { "tag": "domain.finance", "gte": 1 },
          { "tag": "audience.public", "gte": 1 }
        ]
      },
      "card": "research.finance-advice"
    },
    {
      "id": "research-rule.location",
      "type": "research",
      "when": { "tag": "domain.map", "gte": 1 },
      "card": "research.location"
    },
    {
      "id": "research-rule.copyright",
      "type": "research",
      "when": {
        "all": [
          {
            "any": [
              { "tag": "type.quiz", "gte": 1 },
              { "tag": "domain.image", "gte": 1 }
            ]
          },
          {
            "not": { "tag": "audience.me", "gte": 1 }
          }
        ]
      },
      "card": "research.copyright"
    },
    {
      "id": "research-rule.pick-public-api",
      "type": "research",
      "when": { "cartHas": "data-go-kr" },
      "card": "research.pick-public-api"
    },
    {
      "id": "research-rule.schedule-run",
      "type": "research",
      "when": {
        "all": [
          { "tag": "need.notify", "gte": 1 },
          {
            "not": { "deferred": "slot.notify" }
          }
        ]
      },
      "card": "research.schedule-run"
    },
    {
      "id": "safety.proxy-key",
      "type": "safety",
      "when": {
        "all": [
          {
            "cartAny": { "field": "keyExposureRisk", "is": true }
          },
          {
            "cartAny": { "capability": "proxy" }
          }
        ]
      },
      "line": "API 키는 화면 코드에 넣지 않고, 중간 서버의 비밀 값(Workers의 Secret, 앱스 스크립트의 스크립트 속성 같은 환경 변수)에서만 꺼내 쓴다."
    },
    {
      "id": "safety.local-key",
      "type": "safety",
      "when": {
        "all": [
          {
            "cartAny": { "field": "keyExposureRisk", "is": true }
          },
          {
            "not": {
              "cartAny": { "capability": "proxy" }
            }
          },
          { "tag": "audience.me", "gte": 1 }
        ]
      },
      "line": "중간 서버가 없으니 이 앱은 내 컴퓨터에서만 쓴다. 코딩 에이전트를 쓰면 키를 .env 파일에 둔다. 환경 변수를 쓸 수 없는 HTML 파일 한 장이면, 11번 첫 줄의 예외로 키를 코드 맨 위 한 곳에만 둔다. 키가 든 파일은 저장소나 공개 주소에 올리지 않고 남에게 보내지 않는다. 다른 사람과 나누기 전에 키를 중간 서버로 옮긴다."
    },
    {
      "id": "safety.public-key",
      "type": "safety",
      "when": {
        "cartAny": { "field": "publicKey", "is": true }
      },
      "line": "지도 JavaScript 키처럼 화면에 넣도록 만든 공개 키는 화면 코드에 넣어도 된다. 대신 제공처 설정에서 내 사이트 주소에서만 쓰이게 막아 둔다."
    },
    {
      "id": "safety.form-responses",
      "type": "safety",
      "when": { "tag": "type.form", "gte": 1 },
      "line": "제출된 응답을 앱 화면에 다시 보여 주지 않는다. 응답은 만든 사람만 저장 공간(예: 구글 시트)에서 본다."
    },
    {
      "id": "safety.personal-minimum",
      "type": "safety",
      "when": { "tag": "sensitive.personal", "gte": 1 },
      "line": "개인정보는 꼭 필요한 항목만 받고, 받는 이유와 보관 기간을 입력 화면에 적는다. 다 쓴 정보를 지우는 방법도 만든다."
    },
    {
      "id": "safety.students",
      "type": "safety",
      "when": { "tag": "sensitive.students", "gte": 1 },
      "line": "학생 정보는 이름 대신 번호나 별명으로 받을 수 있는지 먼저 나에게 묻는다."
    },
    {
      "id": "safety.payment-test",
      "type": "safety",
      "when": { "tag": "sensitive.payment", "gte": 1 },
      "line": "결제는 테스트 모드로만 만든다. 실제 결제 연결은 내가 약관과 사업자 요건을 확인한 뒤 따로 한다."
    },
    {
      "id": "safety.finance-words",
      "type": "safety",
      "when": { "tag": "domain.finance", "gte": 1 },
      "line": "'사라', '팔아라', '수익 보장' 같은 투자 권유 문구를 쓰지 않고, 화면에 '투자 판단의 책임은 본인에게 있습니다'를 넣는다."
    },
    {
      "id": "safety.trading-key",
      "type": "safety",
      "when": { "cartHas": "kis-open-api" },
      "line": "증권사 키로는 실제 주문도 할 수 있으니 시세 조회만 만들고 주문 기능은 만들지 않는다. 처음엔 모의투자 키로 시험한다."
    },
    {
      "id": "safety.location-minimum",
      "type": "safety",
      "when": { "tag": "domain.map", "gte": 1 },
      "line": "이용자 위치는 화면에서만 쓰고 서버에 저장하지 않는다. 저장이 꼭 필요하면 먼저 나에게 묻는다."
    },
    {
      "id": "stuck.workers-secret",
      "type": "stuck",
      "when": {
        "all": [
          { "cartHas": "cloudflare-workers" },
          {
            "cartAny": { "field": "keyExposureRisk", "is": true }
          }
        ]
      },
      "text": "Cloudflare Workers에서는 키를 코드에 적지 말고 비밀 값(Secret)으로 등록해요. 배포한 Worker에는 터미널에서 npx wrangler secret put (키 이름)으로 넣고, 내 컴퓨터에서 시험할 땐 .dev.vars 파일에 넣고 그 파일을 .gitignore에 적어요.",
      "concepts": ["env-var"]
    },
    {
      "id": "stuck.apps-script-key",
      "type": "stuck",
      "when": {
        "all": [
          { "cartHas": "google-sheets-apps-script" },
          {
            "cartAny": { "field": "keyExposureRisk", "is": true }
          }
        ]
      },
      "text": "앱스 스크립트에서는 키를 '프로젝트 설정 → 스크립트 속성'에 넣고, 서버 쪽 코드(Code.gs)에서 PropertiesService로 꺼내 UrlFetchApp으로 불러요. 키를 화면 HTML로 넘기지 않아요.",
      "concepts": ["env-var"]
    },
    {
      "id": "stuck.apps-script-html",
      "type": "stuck",
      "when": {
        "all": [
          { "cartHas": "html-single" },
          { "cartHas": "google-sheets-apps-script" }
        ]
      },
      "text": "화면 HTML도 처음부터 앱스 스크립트 편집기(script.google.com)에 HTML 파일로 만들고, '배포 → 배포 테스트' 주소로 열어 봐요. 시트는 저장할 데이터가 있을 때만 만들면 돼요."
    },
    {
      "id": "stuck.workers-cron",
      "type": "stuck",
      "when": {
        "all": [
          { "tag": "need.notify", "gte": 1 },
          {
            "not": { "deferred": "slot.notify" }
          },
          { "cartHas": "cloudflare-workers" }
        ]
      },
      "text": "정해진 시간마다 확인하려면 Workers의 Cron Triggers(예약 실행)를 켜요. 설정 파일의 triggers.crons에 실행 주기를 적어요."
    },
    {
      "id": "stuck.apps-script-trigger",
      "type": "stuck",
      "when": {
        "all": [
          { "tag": "need.notify", "gte": 1 },
          {
            "not": { "deferred": "slot.notify" }
          },
          { "cartHas": "google-sheets-apps-script" }
        ]
      },
      "text": "앱스 스크립트에서는 '트리거' 메뉴에서 시간 기반 트리거를 추가하면 정해진 시간마다 실행돼요."
    },
    {
      "id": "stuck.cors-no-proxy",
      "type": "stuck",
      "when": {
        "all": [
          {
            "cartAny": { "capability": "data", "field": "keyExposureRisk", "is": true }
          },
          {
            "not": {
              "cartAny": { "capability": "proxy" }
            }
          },
          { "tag": "audience.me", "gte": 1 }
        ]
      },
      "note": "나만 쓰는 앱은 키 노출 충돌을 띄우지 않지만(D14), 화면에서 바로 부르면 CORS로 막힐 수 있다 (D34)",
      "text": "중간 서버 없이 화면에서 바로 API를 부르면 CORS 때문에 막힐 수 있어요. 그러면 코드쇼퍼로 돌아가 중간 서버 기능이 있는 도구(구글 시트 + 앱스 스크립트, Cloudflare Workers 등)를 고르고 설계도를 새로 받으세요.",
      "concepts": ["cors"]
    }
  ]
}
