{
  "name": "codeitso",
  "version": "0.1.0",
  "private": true,
  "description": "코드잇소(codeitso): 바이브코딩 재료 쇼핑몰. 앱 만들 공개 재료를 담아 프롬프트 한 장으로 내 AI에게 건넨다",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "catalog": "node scripts/catalog/build.ts",
    "predev": "node scripts/catalog/build.ts --if-stale",
    "dev": "astro dev",
    "build": "node scripts/catalog/build.ts --if-stale && astro build",
    "build:cf": "node scripts/deploy/cf-build.ts",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "astro check && tsc -p tsconfig.json && npm run typecheck:worker",
    "typecheck:worker": "wrangler types worker/worker-configuration.d.ts > /dev/null && tsc -p worker/tsconfig.json",
    "check": "npm run tokens && npm run fonts:check && npm run guard && npm run words && npm run harness && npm run typecheck && npm run test",
    "guard": "node scripts/guard/floor-guard.ts",
    "qa:shots": "node scripts/qa/shots.ts",
    "qa:budget": "node scripts/qa/budget.ts",
    "qa:base": "node scripts/qa/base-build.ts",
    "harness": "node scripts/guard/validate-harness.ts",
    "tokens": "node scripts/check-tokens.ts",
    "fonts": "node scripts/fonts/build-fonts.ts",
    "fonts:check": "node scripts/fonts/build-fonts.ts --check",
    "e2e": "playwright test",
    "e2e:base": "node scripts/qa/base-build.ts --e2e",
    "words": "node scripts/guard/check-words.ts",
    "logo": "node scripts/brand/make-logo.ts",
    "logo:word": "node scripts/brand/make-wordmark.ts",
    "import": "node scripts/import/design-all.ts && node scripts/import/ai-import.ts && node scripts/import/api-all.ts && node scripts/import/oss-all.ts && node scripts/import/media-readme.ts",
    "import:design": "node scripts/import/design-all.ts",
    "import:ai": "node scripts/import/ai-import.ts",
    "import:api": "node scripts/import/api-all.ts",
    "import:oss": "node scripts/import/oss-all.ts",
    "import:media": "node scripts/import/media-readme.ts",
    "refresh": "node scripts/import/refresh-all.ts",
    "ko": "node scripts/i18n/template-ko.ts",
    "ko:translate": "node scripts/i18n/translate.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "^8.17.1",
    "fontverter": "2.0.0",
    "subset-font": "2.9.0",
    "typescript": "^5.9.2",
    "vitest": "5.0.3",
    "wrangler": "4.141.0"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.6",
    "@nanostores/persistent": "1.3.5",
    "@nanostores/preact": "1.1.0",
    "astro": "7.3.8",
    "lz-string": "1.5.0",
    "minisearch": "7.2.0",
    "nanostores": "1.5.4",
    "preact": "10.29.8"
  },
  "overrides": {
    "playwright-core": "1.56.1",
    "vitest": "5.0.3"
  }
}
