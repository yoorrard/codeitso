{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-api-index.json",
  "title": "API 진열대 목차 (data/catalog/api/index.json)",
  "type": "object",
  "required": [
    "category",
    "nameKo",
    "fetchedAt",
    "total",
    "subcategories",
    "sources",
    "rejected"
  ],
  "additionalProperties": false,
  "properties": {
    "category": {
      "const": "api"
    },
    "nameKo": {
      "type": "string",
      "minLength": 1
    },
    "fetchedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "subcategories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nameKo",
          "count",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "nameKo": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "count"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "license",
          "file",
          "count",
          "fetchedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "fetchedAt": {
            "type": "string"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
