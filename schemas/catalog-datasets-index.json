{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-datasets-index.json",
  "title": "데이터셋 진열대 목차 (data/catalog/datasets/index.json)",
  "type": "object",
  "required": [
    "category",
    "nameKo",
    "fetchedAt",
    "total",
    "subcategories",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "category": {
      "const": "datasets"
    },
    "nameKo": {
      "type": "string",
      "minLength": 1
    },
    "fetchedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "subcategories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nameKo",
          "count",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "ai-training",
              "kaggle",
              "ml-classic",
              "kr-public",
              "kr-language",
              "world-stats",
              "open-data",
              "sample-data"
            ]
          },
          "nameKo": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "count"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "license",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "license": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "cut": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
