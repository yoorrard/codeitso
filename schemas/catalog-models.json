{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-models.json",
  "title": "AI 모델 사실 (data/catalog-models/models-dev.json, D141): models.dev api.json의 모델 칸을 그대로 옮긴 것. 제공자 id → 모델(id 순). 가격은 100만 토큰당 달러",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "fetchedAt", "providers", "count", "models"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "license", "note"],
      "properties": {
        "id": { "const": "models-dev" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "fetchedAt": { "$ref": "#/$defs/day" },
    "providers": { "type": "integer", "minimum": 1 },
    "count": { "type": "integer", "minimum": 1 },
    "models": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/model" }
      }
    }
  },
  "$defs": {
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "usd": { "type": "number", "minimum": 0 },
    "tokens": { "type": "integer", "minimum": 1 },
    "kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2,12}$" }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "limit", "modalities", "reasoning", "tool_call", "attachment", "open_weights"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "name": { "type": "string", "minLength": 1 },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "input": { "$ref": "#/$defs/usd" },
            "output": { "$ref": "#/$defs/usd" },
            "cache_read": { "$ref": "#/$defs/usd" },
            "cache_write": { "$ref": "#/$defs/usd" },
            "input_audio": { "$ref": "#/$defs/usd" },
            "output_audio": { "$ref": "#/$defs/usd" },
            "context_over_200k": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "input": { "$ref": "#/$defs/usd" },
                "output": { "$ref": "#/$defs/usd" },
                "cache_read": { "$ref": "#/$defs/usd" },
                "cache_write": { "$ref": "#/$defs/usd" }
              }
            }
          }
        },
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context": { "$ref": "#/$defs/tokens" },
            "input": { "$ref": "#/$defs/tokens" },
            "output": { "$ref": "#/$defs/tokens" }
          }
        },
        "modalities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output"],
          "properties": {
            "input": { "$ref": "#/$defs/kinds" },
            "output": { "$ref": "#/$defs/kinds" }
          }
        },
        "reasoning": { "type": "boolean" },
        "tool_call": { "type": "boolean" },
        "attachment": { "type": "boolean" },
        "open_weights": { "type": "boolean" },
        "knowledge": { "$ref": "#/$defs/month" },
        "release_date": { "$ref": "#/$defs/month" },
        "last_updated": { "$ref": "#/$defs/month" },
        "status": { "enum": ["deprecated", "beta", "alpha"] }
      }
    }
  }
}
