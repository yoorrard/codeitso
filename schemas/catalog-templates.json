{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-templates.json",
  "title": "템플릿·스타터 진열대 자료 파일 (data/catalog/templates/<출처>.json)",
  "type": "object",
  "required": [
    "source",
    "fetchedAt",
    "count",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "목록 메타데이터를 싣는 근거 (자료 라이선스나 이용 조건)"
        },
        "note": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "출처 전체 개수 (인기 기준으로 자른 경우)"
        },
        "cut": {
          "type": "string",
          "description": "자른 기준"
        }
      }
    },
    "fetchedAt": {
      "$ref": "#/$defs/date"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "category",
        "summary",
        "url",
        "source",
        "tags",
        "fetchedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+:[a-z0-9.-]+$",
          "description": "<출처>:<슬러그> (owner/repo는 owner--repo)"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "web-starter",
            "saas",
            "ai-app",
            "admin",
            "landing",
            "blog-portfolio",
            "docs-site",
            "ecommerce",
            "mobile",
            "desktop",
            "extension",
            "bot",
            "backend",
            "game",
            "html"
          ]
        },
        "category": {
          "const": "templates"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "출처의 원문(원래 언어)"
        },
        "summaryKo": {
          "type": "string",
          "minLength": 1
        },
        "written": {
          "const": "codeshopper"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "source": {
          "type": "object",
          "required": [
            "name",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stars": {
              "type": "integer",
              "minimum": 0
            },
            "downloads": {
              "type": "integer",
              "minimum": 0
            },
            "likes": {
              "type": "integer",
              "minimum": 0
            },
            "updatedAt": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preview": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "font",
                "palette",
                "icons",
                "style",
                "repo",
                "model",
                "dataset",
                "api",
                "skill",
                "mcp",
                "site",
                "template",
                "asset",
                "prompt"
              ]
            }
          }
        },
        "use": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "install": {
              "type": "string"
            },
            "snippet": {
              "type": "string"
            },
            "docs": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        },
        "fetchedAt": {
          "$ref": "#/$defs/date"
        }
      },
      "dependentRequired": {
        "summaryKo": [
          "written"
        ]
      }
    }
  }
}
