{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.schema.json",
  "title": "공통 정의",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
      "description": "소문자·숫자·하이픈·점만 쓴다. 예: neis-meal, slot.data, domain.education"
    },
    "tagId": {
      "type": "string",
      "pattern": "^(type|audience|ai|aitool|need|domain|topic|budget|sensitive|device|style)\\.[a-z0-9-]+$",
      "description": "aitool.* 태그는 '쓰는 AI' 질문(optional)만 달고 점수·규칙·노출 조건에 쓰지 않는다 (npm run validate)"
    },
    "questionId": { "type": "string", "pattern": "^q\\.[a-z0-9-]+$" },
    "slotId": { "type": "string", "pattern": "^slot\\.[a-z0-9-]+$" },
    "capability": {
      "enum": ["screen", "store", "auth", "data", "host", "proxy", "notify"],
      "description": "screen 화면, store 저장, auth 로그인, data 외부 데이터, host 배포·공유, proxy 키를 숨겨 주는 중간 서버, notify 알림"
    },
    "yearMonth": { "type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$" },
    "url": { "type": "string", "pattern": "^https://" },
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "productField": {
      "enum": [
        "provider.type",
        "access",
        "realtime",
        "serverRegion",
        "layer",
        "cost.free",
        "keyExposureRisk",
        "publicKey",
        "recommendable",
        "custom"
      ],
      "description": "custom: 이용자가 직접 쓴 도구(목록에 없는 도구, D74)면 참. 진열·색인 도구는 늘 거짓"
    },
    "productPredicate": {
      "type": "object",
      "description": "장바구니 상품 하나가 모든 조건을 동시에 만족하면 참. capability와 field는 함께 쓸 수 있다.",
      "properties": {
        "capability": { "$ref": "#/$defs/capability" },
        "field": { "$ref": "#/$defs/productField" },
        "is": { "type": ["string", "boolean", "number"] },
        "in": {
          "type": "array",
          "items": { "type": ["string", "boolean", "number"] },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["capability"] },
        { "required": ["field", "is"] },
        { "required": ["field", "in"] }
      ],
      "dependentRequired": { "is": ["field"], "in": ["field"] },
      "not": { "required": ["is", "in"] }
    },
    "condition": {
      "description": "규칙과 질문 노출에 쓰는 조건. 아래 모양 중 정확히 하나.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "always": { "const": true }
          },
          "required": ["always"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "answer": { "$ref": "#/$defs/questionId" },
            "is": { "$ref": "#/$defs/id" }
          },
          "required": ["answer", "is"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "answer": { "$ref": "#/$defs/questionId" },
            "in": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" },
              "minItems": 1
            }
          },
          "required": ["answer", "in"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": { "$ref": "#/$defs/tagId" },
            "gte": { "type": "number" }
          },
          "required": ["tag", "gte"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cartHas": { "$ref": "#/$defs/id" }
          },
          "required": ["cartHas"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cartAny": { "$ref": "#/$defs/productPredicate" }
          },
          "required": ["cartAny"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": { "$ref": "#/$defs/condition" },
              "minItems": 1
            }
          },
          "required": ["all"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": { "$ref": "#/$defs/condition" },
              "minItems": 1
            }
          },
          "required": ["any"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": { "$ref": "#/$defs/condition" }
          },
          "required": ["not"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "deferred": { "$ref": "#/$defs/slotId" }
          },
          "required": ["deferred"],
          "additionalProperties": false,
          "description": "그 칸을 나중으로 미뤘다 (점검 뒤 규칙에서만)"
        }
      ]
    },
    "conflictId": {
      "type": "string",
      "pattern": "^conflict\\.[a-z0-9-]+(:(slot\\.[a-z0-9-]+|custom-[1-5]))?$",
      "description": "충돌 id. 빈 칸 충돌은 conflict.empty-slot:slot.이름, 직접 쓴 도구 서행은 conflict.custom-tool:custom-n 꼴"
    }
  }
}
