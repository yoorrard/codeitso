{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "templates.schema.json",
  "title": "영수증·설계도 문장 틀",
  "description": "화면과 설계도에 나가는 문장은 코드가 아니라 여기에 둔다. {{이름}} 자리는 엔진이 채운다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "types",
    "slotSteps",
    "styles",
    "devices",
    "audiences",
    "aiTools",
    "accessLabels",
    "leadLabels",
    "reasonLabels",
    "conLabels",
    "badges",
    "notBuildRules",
    "receipt",
    "pack",
    "safetyDefaults",
    "conversationCards",
    "proxyStep",
    "emptySlot",
    "indexResearch",
    "errorFallback",
    "disclaimer"
  ],
  "$defs": {
    "researchText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "what", "why", "where", "doneWhen"],
      "properties": {
        "area": { "type": "string" },
        "what": { "type": "string" },
        "why": { "type": "string" },
        "where": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "doneWhen": { "type": "string" }
      }
    },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "scoreKeyLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "topic",
        "aiTool",
        "budget",
        "realtime",
        "difficulty",
        "official",
        "access",
        "proxy",
        "shared",
        "local"
      ],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "aiTool": { "type": "string", "minLength": 1 },
        "budget": { "type": "string", "minLength": 1 },
        "realtime": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string", "minLength": 1 },
        "official": { "type": "string", "minLength": 1 },
        "access": { "type": "string", "minLength": 1 },
        "proxy": { "type": "string", "minLength": 1 },
        "shared": { "type": "string", "minLength": 1 },
        "local": { "type": "string", "minLength": 1 }
      },
      "description": "점수 항목별 짧은 말 (좋은 쪽)"
    },
    "conKeyLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "budget", "realtime", "difficulty", "access", "local"],
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "budget": { "type": "string", "minLength": 1 },
        "realtime": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string", "minLength": 1 },
        "access": { "type": "string", "minLength": 1 },
        "local": { "type": "string", "minLength": 1 }
      },
      "description": "점수가 깎인 항목의 짧은 말 (아쉬운 쪽)"
    }
  },
  "properties": {
    "version": { "const": 1 },
    "types": {
      "type": "object",
      "propertyNames": { "pattern": "^type\\.[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "goal", "screens", "features"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "screens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "parts"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "parts": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                }
              }
            }
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "doneWhen"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "doneWhen": { "type": "string", "minLength": 1 }
              }
            }
          },
          "dataModel": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entity", "fields"],
              "properties": {
                "entity": { "type": "string" },
                "fields": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                }
              }
            }
          },
          "alternative": { "type": "string", "description": "코딩 없이 되는 방법. 점검에서 '코딩 없이 가는 지름길'로 한 줄 알려 준다" }
        }
      }
    },
    "slotSteps": {
      "type": "object",
      "propertyNames": { "$ref": "defs.schema.json#/$defs/slotId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "doneWhen"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "doneWhen": { "type": "string", "minLength": 1 },
          "screen": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "parts"],
            "properties": {
              "name": { "type": "string" },
              "parts": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            },
            "description": "이 칸이 열리면 화면 목록에 더할 화면"
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "propertyNames": { "pattern": "^style\\.[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "palette", "radius", "fontFamily", "baseFontSize", "note"],
        "properties": {
          "label": { "type": "string" },
          "palette": {
            "type": "object",
            "additionalProperties": false,
            "required": ["background", "surface", "text", "accent", "accentText"],
            "properties": {
              "background": { "$ref": "#/$defs/hex" },
              "surface": { "$ref": "#/$defs/hex" },
              "text": { "$ref": "#/$defs/hex" },
              "accent": { "$ref": "#/$defs/hex" },
              "accentText": { "$ref": "#/$defs/hex" }
            }
          },
          "radius": { "type": "string", "pattern": "^[0-9]+px$" },
          "fontFamily": { "type": "string" },
          "baseFontSize": { "type": "string", "pattern": "^[0-9]+px$" },
          "note": { "type": "string" }
        }
      }
    },
    "devices": {
      "type": "object",
      "propertyNames": { "pattern": "^device\\.[a-z0-9-]+$" },
      "additionalProperties": { "type": "string" }
    },
    "audiences": {
      "type": "object",
      "propertyNames": { "pattern": "^audience\\.[a-z0-9-]+$" },
      "additionalProperties": { "type": "string" }
    },
    "aiTools": {
      "type": "object",
      "propertyNames": { "pattern": "^ai\\.[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "saveAs", "packRef", "workStyle"],
        "properties": {
          "label": { "type": "string" },
          "saveAs": { "type": "string", "description": "설계도를 어디에 어떻게 넣는지 한 줄 안내" },
          "packRef": { "type": "string", "description": "대화 카드(AI에게 할 말)에서 설계도를 가리키는 말" },
          "workStyle": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 3
          }
        }
      }
    },
    "accessLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["none", "signup", "key", "approval", "account-or-business"],
      "properties": {
        "none": { "type": "string" },
        "signup": { "type": "string" },
        "key": { "type": "string" },
        "approval": { "type": "string" },
        "account-or-business": { "type": "string" }
      }
    },
    "reasonLabels": { "$ref": "#/$defs/scoreKeyLabels" },
    "conLabels": { "$ref": "#/$defs/conKeyLabels" },
    "badges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["free", "easy", "official", "realtime", "frequent", "caution"],
      "properties": {
        "free": { "type": "string" },
        "easy": { "type": "string" },
        "official": { "type": "string" },
        "realtime": { "type": "string" },
        "frequent": { "type": "string" },
        "caution": { "type": "string" }
      }
    },
    "notBuildRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "text"],
        "properties": {
          "when": { "$ref": "defs.schema.json#/$defs/condition" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "destination",
        "unnamed",
        "free",
        "paid",
        "paidIncluded",
        "later",
        "more",
        "levels",
        "timeFormat",
        "total",
        "totalFree",
        "time",
        "difficulty",
        "prep",
        "study",
        "research",
        "stamp",
        "footer"
      ],
      "properties": {
        "title": { "type": "string" },
        "destination": { "type": "string" },
        "free": { "type": "string" },
        "paid": { "type": "string" },
        "total": { "type": "string", "description": "도구 비용 합계 이름표 ('요금'은 코드쇼퍼 이용료에만 쓴다)" },
        "totalFree": { "type": "string", "description": "모든 도구가 0원으로 시작할 수 있을 때의 합계 값" },
        "time": { "type": "string" },
        "difficulty": { "type": "string" },
        "prep": { "type": "string" },
        "study": { "type": "string" },
        "research": { "type": "string" },
        "stamp": { "type": "string" },
        "footer": { "type": "string" },
        "unnamed": { "type": "string", "description": "한 줄 입력도 유형도 없을 때 쓰는 이름" },
        "paidIncluded": { "type": "string" },
        "later": { "type": "string", "description": "나중에 붙일 것 품목 표시" },
        "more": { "type": "string", "description": "맡은 칸이 많을 때. {{n}}에 나머지 칸 수" },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["easy", "normal", "hard"],
          "properties": {
            "easy": { "type": "string" },
            "normal": { "type": "string" },
            "hard": { "type": "string" }
          }
        },
        "timeFormat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minutes", "hours", "hoursHalf"],
          "properties": {
            "minutes": { "type": "string" },
            "hours": { "type": "string" },
            "hoursHalf": { "type": "string" }
          },
          "description": "예상 시간 글자. {{m}} 분, {{h}} 시간"
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "intro",
        "headings",
        "scopeRule",
        "researchIntro",
        "noResearch",
        "stepRule",
        "conceptLink",
        "deferredNote",
        "a11yLine",
        "indexMemo",
        "noPrep",
        "prepIntro",
        "noToolStep",
        "dataLines",
        "labels"
      ],
      "properties": {
        "title": { "type": "string" },
        "intro": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "headings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what",
            "scope",
            "screens",
            "features",
            "data",
            "design",
            "tools",
            "prep",
            "research",
            "steps",
            "safety",
            "work"
          ],
          "properties": {
            "what": { "type": "string" },
            "scope": { "type": "string" },
            "screens": { "type": "string" },
            "features": { "type": "string" },
            "data": { "type": "string" },
            "design": { "type": "string" },
            "tools": { "type": "string" },
            "prep": { "type": "string" },
            "research": { "type": "string" },
            "steps": { "type": "string" },
            "safety": { "type": "string" },
            "work": { "type": "string" }
          }
        },
        "scopeRule": { "type": "string" },
        "researchIntro": { "type": "string" },
        "noResearch": { "type": "string" },
        "stepRule": { "type": "string" },
        "conceptLink": { "type": "string", "description": "용어 카드 주소 틀(/terms/아이디). {{site}}와 {{id}}를 채운다" },
        "deferredNote": { "type": "string" },
        "a11yLine": { "type": "string" },
        "indexMemo": { "type": "string" },
        "noPrep": { "type": "string" },
        "prepIntro": { "type": "string" },
        "noToolStep": { "type": "string" },
        "dataLines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["none", "decideLater", "personal", "external"],
          "properties": {
            "none": { "type": "string" },
            "decideLater": { "type": "string" },
            "personal": { "type": "string" },
            "external": { "type": "string" }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oneLine",
            "kind",
            "audience",
            "ai",
            "answers",
            "firstPhase",
            "notBuild",
            "deferred",
            "feature",
            "doneWhen",
            "styleFeel",
            "colors",
            "font",
            "fontSize",
            "radius",
            "screenSize",
            "a11y",
            "colorBackground",
            "colorSurface",
            "colorText",
            "colorAccent",
            "colorAccentText",
            "toolSlot",
            "toolName",
            "toolProvider",
            "toolAccess",
            "toolCost",
            "toolLicense",
            "toolChecked",
            "toolOther",
            "memo",
            "instruction",
            "stuck",
            "together",
            "what",
            "why",
            "where",
            "researchDone",
            "check",
            "concepts",
            "issued",
            "format"
          ],
          "properties": {
            "oneLine": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "audience": { "type": "string", "minLength": 1 },
            "ai": { "type": "string", "minLength": 1 },
            "answers": { "type": "string", "minLength": 1 },
            "firstPhase": { "type": "string", "minLength": 1 },
            "notBuild": { "type": "string", "minLength": 1 },
            "deferred": { "type": "string", "minLength": 1 },
            "feature": { "type": "string", "minLength": 1 },
            "doneWhen": { "type": "string", "minLength": 1 },
            "styleFeel": { "type": "string", "minLength": 1 },
            "colors": { "type": "string", "minLength": 1 },
            "font": { "type": "string", "minLength": 1 },
            "fontSize": { "type": "string", "minLength": 1 },
            "radius": { "type": "string", "minLength": 1 },
            "screenSize": { "type": "string", "minLength": 1 },
            "a11y": { "type": "string", "minLength": 1 },
            "colorBackground": { "type": "string", "minLength": 1 },
            "colorSurface": { "type": "string", "minLength": 1 },
            "colorText": { "type": "string", "minLength": 1 },
            "colorAccent": { "type": "string", "minLength": 1 },
            "colorAccentText": { "type": "string", "minLength": 1 },
            "toolSlot": { "type": "string", "minLength": 1 },
            "toolName": { "type": "string", "minLength": 1 },
            "toolProvider": { "type": "string", "minLength": 1 },
            "toolAccess": { "type": "string", "minLength": 1 },
            "toolCost": { "type": "string", "minLength": 1 },
            "toolLicense": { "type": "string", "minLength": 1 },
            "toolChecked": { "type": "string", "minLength": 1 },
            "toolOther": { "type": "string", "minLength": 1 },
            "memo": { "type": "string", "minLength": 1 },
            "instruction": { "type": "string", "minLength": 1 },
            "stuck": { "type": "string", "minLength": 1 },
            "together": { "type": "string", "minLength": 1 },
            "what": { "type": "string", "minLength": 1 },
            "why": { "type": "string", "minLength": 1 },
            "where": { "type": "string", "minLength": 1 },
            "researchDone": { "type": "string", "minLength": 1 },
            "check": { "type": "string", "minLength": 1 },
            "concepts": { "type": "string", "minLength": 1 },
            "issued": { "type": "string", "minLength": 1 },
            "format": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "safetyDefaults": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "conversationCards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "when", "text"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/id" },
          "title": { "type": "string" },
          "when": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "emptySlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "fixHint", "research"],
      "properties": {
        "message": { "type": "string" },
        "fixHint": { "type": "string" },
        "research": { "$ref": "#/$defs/researchText" }
      }
    },
    "indexResearch": { "$ref": "#/$defs/researchText" },
    "errorFallback": { "type": "string" },
    "disclaimer": { "type": "string" },
    "leadLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instant", "hours", "days"],
      "properties": {
        "instant": { "type": "string" },
        "hours": { "type": "string" },
        "days": { "type": "string" }
      }
    },
    "proxyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "doneWhen"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "doneWhen": { "type": "string", "minLength": 1 }
      },
      "description": "키 노출 위험 상품과 중간 서버 상품을 함께 골랐을 때 데이터 단계 앞에 넣는 단계"
    }
  }
}
