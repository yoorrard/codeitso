{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "templates.schema.json",
  "title": "영수증·설계도 문장 틀",
  "description": "화면과 설계도에 나가는 문장은 코드가 아니라 여기에 둔다. {{이름}} 자리는 엔진이 채운다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "types",
    "slotSteps",
    "styles",
    "devices",
    "audiences",
    "aiTools",
    "accessLabels",
    "leadLabels",
    "reasonLabels",
    "conLabels",
    "badges",
    "notBuildRules",
    "receipt",
    "pack",
    "safetyDefaults",
    "conversationCards",
    "proxyStep",
    "emptySlot",
    "indexResearch",
    "errorFallback",
    "disclaimer",
    "customAnswer",
    "customTool",
    "builderPublish"
  ],
  "$defs": {
    "researchText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "what", "why", "where", "doneWhen"],
      "properties": {
        "area": { "type": "string" },
        "what": { "type": "string" },
        "why": { "type": "string" },
        "where": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "doneWhen": { "type": "string" }
      }
    },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "scoreKeyLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "topic",
        "aiTool",
        "budget",
        "realtime",
        "difficulty",
        "official",
        "access",
        "proxy",
        "shared",
        "local"
      ],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "aiTool": { "type": "string", "minLength": 1 },
        "budget": { "type": "string", "minLength": 1 },
        "realtime": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string", "minLength": 1 },
        "official": { "type": "string", "minLength": 1 },
        "access": { "type": "string", "minLength": 1 },
        "proxy": { "type": "string", "minLength": 1 },
        "shared": { "type": "string", "minLength": 1 },
        "local": { "type": "string", "minLength": 1 }
      },
      "description": "점수 항목별 짧은 말 (좋은 쪽)"
    },
    "conKeyLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "budget", "realtime", "difficulty", "access", "local"],
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "budget": { "type": "string", "minLength": 1 },
        "realtime": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string", "minLength": 1 },
        "access": { "type": "string", "minLength": 1 },
        "local": { "type": "string", "minLength": 1 }
      },
      "description": "점수가 깎인 항목의 짧은 말 (아쉬운 쪽)"
    }
  },
  "properties": {
    "version": { "const": 1 },
    "types": {
      "type": "object",
      "propertyNames": { "pattern": "^type\\.[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "goal", "screens", "features"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "screens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "parts"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "parts": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                }
              }
            }
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "doneWhen"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "doneWhen": { "type": "string", "minLength": 1 }
              }
            }
          },
          "dataModel": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entity", "fields"],
              "properties": {
                "entity": { "type": "string" },
                "fields": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                }
              }
            }
          },
          "alternative": { "type": "string", "description": "코딩 없이 되는 방법. 점검에서 '코딩 없이 가는 지름길'로 한 줄 알려 준다" }
        }
      }
    },
    "slotSteps": {
      "type": "object",
      "propertyNames": { "$ref": "defs.schema.json#/$defs/slotId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "doneWhen"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "doneWhen": { "type": "string", "minLength": 1 },
          "screen": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "parts"],
            "properties": {
              "name": { "type": "string" },
              "parts": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            },
            "description": "이 칸이 열리면 화면 목록에 더할 화면"
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "propertyNames": { "pattern": "^style\\.[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "palette", "radius", "fontFamily", "baseFontSize", "note"],
        "properties": {
          "label": { "type": "string" },
          "palette": {
            "type": "object",
            "additionalProperties": false,
            "required": ["background", "surface", "text", "accent", "accentText"],
            "properties": {
              "background": { "$ref": "#/$defs/hex" },
              "surface": { "$ref": "#/$defs/hex" },
              "text": { "$ref": "#/$defs/hex" },
              "accent": { "$ref": "#/$defs/hex" },
              "accentText": { "$ref": "#/$defs/hex" }
            }
          },
          "radius": { "type": "string", "pattern": "^[0-9]+px$" },
          "fontFamily": { "type": "string" },
          "baseFontSize": { "type": "string", "pattern": "^[0-9]+px$" },
          "note": { "type": "string" }
        }
      }
    },
    "devices": {
      "type": "object",
      "propertyNames": { "pattern": "^device\\.[a-z0-9-]+$" },
      "additionalProperties": { "type": "string" }
    },
    "audiences": {
      "type": "object",
      "propertyNames": { "pattern": "^audience\\.[a-z0-9-]+$" },
      "additionalProperties": { "type": "string" }
    },
    "aiTools": {
      "type": "object",
      "propertyNames": { "pattern": "^ai\\.[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "saveAs", "packRef", "workStyle"],
        "properties": {
          "label": { "type": "string" },
          "saveAs": { "type": "string", "description": "설계도를 어디에 어떻게 넣는지 한 줄 안내" },
          "packRef": { "type": "string", "description": "대화 카드(AI에게 할 말)에서 설계도를 가리키는 말" },
          "workStyle": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 3
          }
        }
      }
    },
    "accessLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["none", "signup", "key", "approval", "account-or-business"],
      "properties": {
        "none": { "type": "string" },
        "signup": { "type": "string" },
        "key": { "type": "string" },
        "approval": { "type": "string" },
        "account-or-business": { "type": "string" }
      }
    },
    "reasonLabels": { "$ref": "#/$defs/scoreKeyLabels" },
    "conLabels": { "$ref": "#/$defs/conKeyLabels" },
    "badges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["free", "easy", "official", "realtime", "frequent", "caution"],
      "properties": {
        "free": { "type": "string" },
        "easy": { "type": "string" },
        "official": { "type": "string" },
        "realtime": { "type": "string" },
        "frequent": { "type": "string" },
        "caution": { "type": "string" }
      }
    },
    "notBuildRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "text"],
        "properties": {
          "when": { "$ref": "defs.schema.json#/$defs/condition" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "destination",
        "unnamed",
        "free",
        "paid",
        "paidIncluded",
        "later",
        "count",
        "more",
        "levels",
        "timeFormat",
        "total",
        "totalFree",
        "time",
        "difficulty",
        "prep",
        "study",
        "research",
        "stamp",
        "footer",
        "unknown",
        "totalUnchecked"
      ],
      "properties": {
        "title": { "type": "string" },
        "destination": { "type": "string" },
        "unknown": { "type": "string", "description": "직접 쓴 도구처럼 비용을 모르는 품목의 비용 칸 (표시 폭이 '유료'와 같아야 줄이 어긋나지 않는다)" },
        "totalUnchecked": { "type": "string", "description": "유료 도구는 없고 비용을 모르는 도구(직접 쓴 도구)가 있을 때의 합계 값" },
        "free": { "type": "string" },
        "paid": { "type": "string" },
        "total": { "type": "string", "description": "도구 비용 합계 이름표 ('요금'은 코드쇼퍼 이용료에만 쓴다)" },
        "totalFree": { "type": "string", "description": "모든 도구가 0원으로 시작할 수 있을 때의 합계 값" },
        "time": { "type": "string" },
        "difficulty": { "type": "string" },
        "prep": { "type": "string" },
        "study": { "type": "string" },
        "research": { "type": "string" },
        "stamp": { "type": "string" },
        "footer": { "type": "string" },
        "unnamed": { "type": "string", "description": "한 줄 입력도 유형도 없을 때 쓰는 이름" },
        "paidIncluded": { "type": "string" },
        "later": { "type": "string", "description": "나중에 붙일 것 품목 표시" },
        "count": { "type": "string", "description": "준비물·읽어 둘 용어·알아볼 것 개수. {{n}}에 개수 (숫자는 단위와 함께)" },
        "more": { "type": "string", "description": "맡은 칸이 많을 때. {{n}}에 나머지 칸 수" },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["easy", "normal", "hard"],
          "properties": {
            "easy": { "type": "string" },
            "normal": { "type": "string" },
            "hard": { "type": "string" }
          }
        },
        "timeFormat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minutes", "hours", "hoursHalf"],
          "properties": {
            "minutes": { "type": "string" },
            "hours": { "type": "string" },
            "hoursHalf": { "type": "string" }
          },
          "description": "예상 시간 글자. {{m}} 분, {{h}} 시간"
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "intro",
        "headings",
        "scopeRule",
        "researchIntro",
        "noResearch",
        "stepRule",
        "conceptLink",
        "deferredNote",
        "a11yLine",
        "indexMemo",
        "noPrep",
        "prepIntro",
        "noToolStep",
        "dataLines",
        "labels",
        "mine"
      ],
      "properties": {
        "title": { "type": "string" },
        "mine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "rule", "picked", "kept", "keptName", "customType"],
          "description": "설계도 1번의 '내 말 그대로' 줄 (직접 쓴 답, D74·input.md 7.3절). {{chip}} 질문 이름, {{text}} 내 말, {{label}} 고른 보기, {{as}} 그대로 둘 때 같게 계산한 것",
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "rule": { "type": "string", "minLength": 1 },
            "picked": { "type": "string", "minLength": 1 },
            "kept": { "type": "string", "minLength": 1 },
            "keptName": { "type": "string", "minLength": 1, "description": "'쓰는 AI'처럼 계산에 쓰지 않는 이름 질문을 그대로 뒀을 때 (계산 기준 꼬리 없음)" },
            "customType": { "type": "string", "minLength": 1, "description": "만들 것을 보기에 없는 앱(type.custom)으로 둘 때만 붙는 줄" }
          }
        },
        "intro": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "headings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what",
            "scope",
            "screens",
            "features",
            "data",
            "design",
            "tools",
            "prep",
            "research",
            "steps",
            "safety",
            "work"
          ],
          "properties": {
            "what": { "type": "string" },
            "scope": { "type": "string" },
            "screens": { "type": "string" },
            "features": { "type": "string" },
            "data": { "type": "string" },
            "design": { "type": "string" },
            "tools": { "type": "string" },
            "prep": { "type": "string" },
            "research": { "type": "string" },
            "steps": { "type": "string" },
            "safety": { "type": "string" },
            "work": { "type": "string" }
          }
        },
        "scopeRule": { "type": "string" },
        "researchIntro": { "type": "string" },
        "noResearch": { "type": "string" },
        "stepRule": { "type": "string" },
        "conceptLink": { "type": "string", "description": "용어 카드 주소 틀(/terms/아이디). {{site}}와 {{id}}를 채운다" },
        "deferredNote": { "type": "string" },
        "a11yLine": { "type": "string" },
        "indexMemo": { "type": "string" },
        "noPrep": { "type": "string" },
        "prepIntro": { "type": "string" },
        "noToolStep": { "type": "string" },
        "dataLines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["none", "decideLater", "personal", "external"],
          "properties": {
            "none": { "type": "string" },
            "decideLater": { "type": "string" },
            "personal": { "type": "string" },
            "external": { "type": "string" }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oneLine",
            "kind",
            "audience",
            "ai",
            "answers",
            "firstPhase",
            "build",
            "notBuild",
            "deferred",
            "feature",
            "doneWhen",
            "styleFeel",
            "colors",
            "font",
            "fontSize",
            "radius",
            "screenSize",
            "a11y",
            "colorBackground",
            "colorSurface",
            "colorText",
            "colorAccent",
            "colorAccentText",
            "toolSlot",
            "toolName",
            "toolProvider",
            "toolAccess",
            "toolCost",
            "toolLicense",
            "toolChecked",
            "toolOther",
            "memo",
            "instruction",
            "stuck",
            "together",
            "what",
            "why",
            "where",
            "researchDone",
            "check",
            "concepts",
            "issued",
            "format"
          ],
          "properties": {
            "oneLine": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "audience": { "type": "string", "minLength": 1 },
            "ai": { "type": "string", "minLength": 1 },
            "answers": { "type": "string", "minLength": 1 },
            "firstPhase": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1, "description": "나중에 붙일 것이 없을 때 '먼저 만들 것' 대신 쓰는 이름" },
            "notBuild": { "type": "string", "minLength": 1 },
            "deferred": { "type": "string", "minLength": 1 },
            "feature": { "type": "string", "minLength": 1 },
            "doneWhen": { "type": "string", "minLength": 1 },
            "styleFeel": { "type": "string", "minLength": 1 },
            "colors": { "type": "string", "minLength": 1 },
            "font": { "type": "string", "minLength": 1 },
            "fontSize": { "type": "string", "minLength": 1 },
            "radius": { "type": "string", "minLength": 1 },
            "screenSize": { "type": "string", "minLength": 1 },
            "a11y": { "type": "string", "minLength": 1 },
            "colorBackground": { "type": "string", "minLength": 1 },
            "colorSurface": { "type": "string", "minLength": 1 },
            "colorText": { "type": "string", "minLength": 1 },
            "colorAccent": { "type": "string", "minLength": 1 },
            "colorAccentText": { "type": "string", "minLength": 1 },
            "toolSlot": { "type": "string", "minLength": 1 },
            "toolName": { "type": "string", "minLength": 1 },
            "toolProvider": { "type": "string", "minLength": 1 },
            "toolAccess": { "type": "string", "minLength": 1 },
            "toolCost": { "type": "string", "minLength": 1 },
            "toolLicense": { "type": "string", "minLength": 1 },
            "toolChecked": { "type": "string", "minLength": 1 },
            "toolOther": { "type": "string", "minLength": 1 },
            "memo": { "type": "string", "minLength": 1 },
            "instruction": { "type": "string", "minLength": 1 },
            "stuck": { "type": "string", "minLength": 1 },
            "together": { "type": "string", "minLength": 1 },
            "what": { "type": "string", "minLength": 1 },
            "why": { "type": "string", "minLength": 1 },
            "where": { "type": "string", "minLength": 1 },
            "researchDone": { "type": "string", "minLength": 1 },
            "check": { "type": "string", "minLength": 1 },
            "concepts": { "type": "string", "minLength": 1 },
            "issued": { "type": "string", "minLength": 1 },
            "format": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "safetyDefaults": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "conversationCards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "when", "text"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/id" },
          "title": { "type": "string" },
          "when": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "emptySlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "fixHint", "research", "researchWithNote"],
      "properties": {
        "message": { "type": "string" },
        "fixHint": { "type": "string" },
        "research": { "$ref": "#/$defs/researchText" },
        "researchWithNote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["what"],
          "description": "가져올 정보를 직접 썼을 때(notes[\"q.domain\"]) 빈 외부 데이터 칸의 '무엇을 확인'만 바꾼다. {{note}}에 내 말",
          "properties": { "what": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "customAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hidden"],
      "description": "직접 쓴 답 (D74). 영수증 링크로 받아 내 말이 없을 때 고른 답 칩에 쓰는 이름",
      "properties": { "hidden": { "type": "string", "minLength": 1 } }
    },
    "customTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "hiddenName", "summary", "cost", "memo", "mark", "unchecked", "message", "messageHidden", "fixHint", "researchArea", "researchAreaHidden", "researchCard"],
      "description": "목록에 없는 도구 (직접 쓴 도구, D74·input.md 8절). {{name}}에 쓴 이름. 엔진이 점수 없는 '모름' 도구를 만들 때 쓴다",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "hiddenName": { "type": "string", "minLength": 1, "description": "영수증 링크로 받아 이름이 없을 때" },
        "summary": { "type": "string", "minLength": 1 },
        "cost": { "type": "string", "minLength": 1, "description": "설계도 7번 표의 비용 칸" },
        "memo": { "type": "string", "minLength": 1, "description": "설계도 7번 도구별 메모" },
        "mark": { "type": "string", "minLength": 1, "description": "설계도 7번 도구 이름 뒤 표시" },
        "unchecked": { "type": "string", "minLength": 1, "description": "설계도 7번 제공·자격·라이선스·확인한 때 칸" },
        "message": { "type": "string", "minLength": 1, "description": "도구끼리 맞춰 보기의 서행 줄" },
