---
// 미리 구운 그림 (docs/CONCEPT.md 5.6·9절, T33): src/assets/art/<name>.png가 있으면 Astro가 AVIF·WebP로 바꿔 싣고,
// 없으면 청사진 자리 표시(같은 실루엣의 SVG)를 낸다. 소유자 그림을 넣고 npm run art만 돌리면 코드를 고치지 않고 바뀐다.
// 그림 위에 CSS로 그림자·외곽선·필터를 더하지 않는다 (빛은 렌더 장치 한 곳에서만 정한다).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Glyph from './Glyph.astro';
import { hasGlyph } from '../lib/glyphs.ts';

interface Props {
  /** 그림 이름 (art-manifest.ts의 출력 이름: 'L01', 'P01', 'P01-square', 'V01-top', 'V01-hero') */
  name: string;
  /** 화면에 보일 너비 (px). 높이는 그림 비율대로 */
  width: number;
  /** 뜻을 전하는 그림이면 대체 글. 장식이면 비운다 */
  alt?: string;
  class?: string;
  /** 첫 화면 그림이면 eager */
  loading?: 'lazy' | 'eager';
}
const { name, width, alt = '', class: cls, loading = 'lazy' } = Astro.props;
const renders = import.meta.glob<{ default: ImageMetadata }>('../assets/art/*.png', { eager: true });
const img = renders[`../assets/art/${name}.png`]?.default;
// 자리 표시는 같은 id의 청사진 그림 (P01-square → P01). 차(V01)는 자리 표시가 없어 아무것도 내지 않는다
const placeholder = name.split('-')[0] ?? name;
---

{
  img ? (
    <Picture src={img} formats={['avif', 'webp']} width={width} widths={[width, width * 2]} sizes={`${width}px`} alt={alt} loading={loading} decoding="async" class:list={['art', cls]} />
  ) : (
    hasGlyph(placeholder) && (
      <span class:list={['art', 'art-placeholder', cls]} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
        <Glyph name={placeholder} />
      </span>
    )
  )
}
