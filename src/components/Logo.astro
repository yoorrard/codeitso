---
// 로고 (v5, D104): 소유자가 준 장바구니 로고에서 npm run logo가 만든 그림 넷(장바구니·글자, 낮·밤 짝).
// 밤 짝은 남색 글자 '코드'와 바퀴를 밝게 바꾼 것이라, 어두운 화면(기기 설정)에서만 보인다 (shop.css .logo-night).
// 이름은 둘러싼 링크가 말하므로 그림은 모두 장식(alt="")이다.
import { FILES } from '../lib/routes.ts';
import sizes from '../lib/brand-sizes.json';

interface Props {
  /** 장바구니 높이(px). 글자는 그 0.55배. 휴대폰 머리줄은 CSS가 조금 줄인다 */
  height?: number;
  /** 글자 '코드잇소'를 함께 그린다 */
  word?: boolean;
  class?: string;
}
const { height = 40, word = true, class: extra } = Astro.props;
const cartW = Math.round((sizes.cart.w / sizes.cart.h) * height);
const wordH = Math.round(height * 0.55);
const wordW = Math.round((sizes.wordmark.w / sizes.wordmark.h) * wordH);
---

<span class:list={['logo', extra]} style={`--logo-h: ${height}px`}>
  <img class="logo-day" src={FILES.cart} width={cartW} height={height} alt="" decoding="async" />
  <img class="logo-night" src={FILES.cartNight} width={cartW} height={height} alt="" decoding="async" />
  {
    word && (
      <>
        <img class="logo-day logo-word" src={FILES.wordmark} width={wordW} height={wordH} alt="" decoding="async" />
        <img class="logo-night logo-word" src={FILES.wordmarkNight} width={wordW} height={wordH} alt="" decoding="async" />
      </>
    )
  }
</span>
