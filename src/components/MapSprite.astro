---
// 지도 표지 묶음 src/assets/map/map-sprite.svg (docs/MAP.md 3절)와 차 그림자 필터(#mb-shade)를 페이지에 한 번 숨겨 넣는다.
// 지도(MapBoard)는 <use href="#mk-…">와 filter="url(#mb-shade)"로 쓴다.
// display:none으로 숨기면 무늬(mk-hatch)를 칠하지 못하는 브라우저가 있어 크기 0, 문서 흐름 밖(map.css .map-sprite)으로 숨긴다.
// 차 그림자 필터는 지도마다 두면 홈(띠 + 코스 미리 보기 시트)에서 id가 겹쳐, 페이지에 하나만 두고 모든 지도가 url(#mb-shade)로 쓴다.
// 돌지 않는 부모(.mb-car-wrap)에 걸어 빛이 늘 왼쪽 위에서 오게 (2, 3) 흐림 없이. 색은 map.css .mb-shade-color.
// 파일이 아직 없으면 아무것도 넣지 않는다.
const raw = Object.values(import.meta.glob<string>('../assets/map/map-sprite.svg', { query: '?raw', import: 'default', eager: true }))[0] ?? '';
const sprite = raw.replace('<svg ', '<svg class="map-sprite" width="0" height="0" ');
---

{raw && <Fragment set:html={sprite} />}
{
  raw && (
    <svg class="map-sprite" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="mb-shade" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
        <feFlood class="mb-shade-color" result="c" />
        <feComposite in="c" in2="SourceAlpha" operator="in" />
        <feOffset dx="2" dy="3" result="s" />
        <feMerge>
          <feMergeNode in="s" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </svg>
  )
}
