---
// 지도 표지 묶음 src/assets/map/map-sprite.svg (docs/MAP.md 3절)를 페이지에 한 번 숨겨 넣는다. 지도(MapBoard)는 <use href="#mk-…">로 쓴다.
// display:none으로 숨기면 무늬(mk-hatch)를 칠하지 못하는 브라우저가 있어 크기 0, 문서 흐름 밖(map.css .map-sprite)으로 숨긴다.
// 파일이 아직 없으면 아무것도 넣지 않는다.
const raw = Object.values(import.meta.glob<string>('../assets/map/map-sprite.svg', { query: '?raw', import: 'default', eager: true }))[0] ?? '';
const sprite = raw.replace('<svg ', '<svg class="map-sprite" width="0" height="0" ');
---

{raw && <Fragment set:html={sprite} />}
