---
// 기사님 그림 (src/assets/mascot/). 화면 크기에 맞는 avif·webp 하나만 내려오게 1배·2배 폭을 만든다.
// 말풍선이 뜻을 전하면 장식이므로 alt를 비워 둔다. 그림을 고치거나 새로 그리지 않는다 (CLAUDE.md 꼭 지킬 것 12).
import { Picture } from 'astro:assets';
import wave from '../assets/mascot/chauffeur-wave.png';

const poses = { wave } as const;

interface Props {
  pose?: keyof typeof poses;
  /** 화면에 보이는 폭(px) */
  width: number;
  alt?: string;
  /** 첫 화면에 바로 보이면 true (지연 불러오기를 끈다) */
  eager?: boolean;
  class?: string;
}
const { pose = 'wave', width, alt = '', eager = false, class: cls } = Astro.props;
---

<Picture
  src={poses[pose]}
  alt={alt}
  widths={[width, width * 2]}
  sizes={`${width}px`}
  width={width}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  class:list={['mascot', cls]}
/>
