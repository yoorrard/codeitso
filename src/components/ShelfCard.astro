---
// 진열대 카드 하나 (T13, docs/UX.md 3.8). 진열 상품은 이름이 상세 페이지 링크이고(카드 어디를 눌러도 간다),
// 기본 항목(이름·설명, 이럴 때 써요, 비용, 난이도)과 배지만 보인다 (R-23·R-24. 추천 이유는 장보기에서만 나온다).
// 색인 상품은 상세 페이지가 없어서 정해진 항목(이름, 설명, 배지, 제공, 원문 링크)만 보인다.
// data-domains·data-caps는 거르기 섬(ShelfFilter)이 읽는다.
import Emoji from './Emoji.astro';
import Icon from './Icon.astro';
import { ko } from '../copy/ko.ts';
import { catalog } from '../lib/data.ts';
import { badges, fill, toolDifficultyWord } from '../lib/engine/index.ts';
import type { Product } from '../lib/engine/index.ts';
import { capabilityLabel, domainLabel, productArt } from '../lib/shelf.ts';
import { toolPath } from '../lib/routes.ts';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const isShelf = p.layer === 'shelf';
const caution = catalog.data.templates.badges.caution;
const stars = ko.shop.stars.repeat(p.difficulty) + ko.shop.starsOff.repeat(3 - p.difficulty);
const caps = p.capabilities.map(capabilityLabel).join(', ');
const domains = (p.domains ?? []).map(domainLabel).join(', ');
---

<li class:list={['card', 'shelf-card', { 'shelf-card-index': !isShelf }]} data-shelf-item data-id={p.id} data-domains={(p.domains ?? []).join(' ')} data-caps={p.capabilities.join(' ')}>
  <div class="shelf-card-head">
    <Emoji id={productArt(p)} size={40} class="product-thumb" />
    <h3>{isShelf ? <a class="shelf-card-link" href={toolPath(p.id)}>{p.name}</a> : p.name}</h3>
  </div>
  <p class="product-summary">{p.summary}</p>
  <ul class="badge-row">
    {
      badges(catalog, p).map((b) =>
        b === caution ? (
          <li class="badge badge-caution">
            <Icon name="warning" size="1.1em" />
            {b}
          </li>
        ) : (
          <li class="badge">{b}</li>
        ),
      )
    }
  </ul>
  {
    isShelf ? (
      <dl class="product-facts">
        {p.useWhen && (
          <>
            <dt>{ko.shop.useWhen}</dt>
            <dd>{p.useWhen}</dd>
          </>
        )}
        <dt>{ko.shop.cost}</dt>
        <dd>{p.cost.note}</dd>
        <dt>{ko.shop.difficulty}</dt>
        <dd>
          <span aria-hidden="true" class="stars">
            {stars}
          </span>
          <span class="visually-hidden">{fill(ko.shop.difficultyText, { level: toolDifficultyWord(catalog, p.difficulty) })}</span>
        </dd>
      </dl>
    ) : (
      <dl class="product-facts">
        <dt>{ko.shop.provider}</dt>
        <dd>
          {p.provider.name} ({ko.shop.providerWords[p.provider.type]})
        </dd>
        <dt>{ko.shelf.source}</dt>
        <dd>
          <ul class="link-list">
            {p.links.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener noreferrer">
                  {l.label}
                  <Icon name="external" size="1em" />
<span class="visually-hidden"> ({ko.shelf.newTab})</span>
                </a>
              </li>
            ))}
          </ul>
        </dd>
      </dl>
    )
  }
  <p class="shelf-tags">
    <span>{ko.shelf.capability}: {caps}</span>{' '}
    {domains && <span>{ko.shelf.domain}: {domains}</span>}
  </p>
</li>
