---
// 도구 모음의 줄 하나 (T32, docs/CONCEPT.md 6.7): 48px 기능 타일 + 이름 + 한 줄 설명, 오른쪽에 '0원으로 시작'/'유료'와 난이도 막대.
// 카드 격자 대신 가는 선으로 나눈 줄 목록이라 360px에서 진열대 길이가 크게 준다. 진열 도구는 이름이 상세 링크이고 줄 어디를 눌러도 간다.
// 원문만 있는 도구(색인)는 상세 페이지가 없어 제공과 원문 링크를 '자세히' 안에 둔다.
// data-domains·data-caps는 거르기 섬(ShelfFilter)이 읽는다.
import Glyph from './Glyph.astro';
import Icon from './Icon.astro';
import { ko } from '../copy/ko.ts';
import { catalog } from '../lib/data.ts';
import { fill, toolDifficultyWord } from '../lib/engine/index.ts';
import type { Product } from '../lib/engine/index.ts';
import { productArt } from '../lib/shelf.ts';
import { toolPath } from '../lib/routes.ts';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const isShelf = p.layer === 'shelf';
const T = catalog.data.templates;
---

<li class:list={['tool-row', { 'tool-row-index': !isShelf }]} data-shelf-item data-id={p.id} data-domains={(p.domains ?? []).join(' ')} data-caps={p.capabilities.join(' ')}>
  <Glyph name={productArt(p)} tile="lg" class="tool-row-art" />
  <div class="tool-row-main">
    <h3 class="tool-row-name">{isShelf ? <a class="shelf-card-link" href={toolPath(p.id)}>{p.name}</a> : p.name}</h3>
    <p class="tool-row-summary">{p.summary}</p>
    {
      !isShelf && (
        <details class="tool-row-more">
          <summary>{ko.shop.details}</summary>
          <p>
            {ko.shop.provider}: {p.provider.name} ({ko.shop.providerWords[p.provider.type]})
          </p>
          <ul class="link-list">
            {p.links.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener noreferrer">
                  {l.label}
                  <Icon name="external" size="1em" />
                  <span class="visually-hidden"> ({ko.shelf.newTab})</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
  <div class="tool-row-side">
    {
      isShelf ? (
        <span class:list={['tool-cost', { 'is-paid': !p.cost.free }]}>{p.cost.free ? T.badges.free : T.receipt.paid}</span>
      ) : (
        <span class="badge badge-caution">
          <Icon name="warning" size="1.1em" />
          {T.badges.caution}
        </span>
      )
    }
    <span class="level">
      <span class="level-bar" aria-hidden="true">
        {[1, 2, 3].map((n) => <span class:list={{ on: n <= p.difficulty }} />)}
      </span>
      {fill(ko.shop.levelLine, { level: toolDifficultyWord(catalog, p.difficulty) })}
    </span>
  </div>
</li>
