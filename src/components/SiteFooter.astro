---
// 바닥글: 로고 · 정보 쪽 링크 · 자료 갱신일과 상품 수 · 라이선스 한 줄 (미리 보기 단계면 시험판 줄) · 방문 수(D134).
import Logo from './Logo.astro';
import VisitCount from './VisitCount.astro';
import { ko } from '../copy/ko.ts';
import { withCommas } from '../lib/catalog/core.ts';
import { ROUTES } from '../lib/routes.ts';
import { STAGE } from '../lib/stage.ts';
import { fill } from '../lib/text.ts';

interface Props {
  fetched: string;
  total: number;
}
const { fetched, total } = Astro.props;
---

<footer class="site-footer">
  <div class="ft-inner">
    <Logo height={28} class="ft-logo" />
    <nav aria-label={ko.footer.label}>
      <ul class="ft-links">
        <li><a href={ROUTES.about}>{ko.footer.about}</a></li>
        <li><a href={ROUTES.terms}>{ko.footer.terms}</a></li>
        <li><a href={ROUTES.credits}>{ko.footer.credits}</a></li>
        <li><a href={ROUTES.privacy}>{ko.footer.privacy}</a></li>
        <li><a href={ROUTES.notice}>{ko.footer.notice}</a></li>
      </ul>
    </nav>
    <p class="ft-line">{fill(ko.footer.fetched, { date: fetched, n: withCommas(total) })}</p>
    <p class="ft-line">{ko.footer.license}</p>
    {STAGE === 'preview' && <p class="ft-line">{ko.footer.trial}</p>}
    <VisitCount />
  </div>
</footer>
