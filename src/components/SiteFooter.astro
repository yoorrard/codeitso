---
// 바닥글 (L, D136): 로고 · 법 문서와 정보 쪽 링크(개인정보 처리방침은 굵게, 국내 서비스 관례) · 운영자와 문의 메일 · 자료 갱신일과 상품 수 ·
// 상품 권리 한 줄 · 저작권 표시 (미리 보기 단계면 시험판 줄) · 방문 수(D134). 운영자 이름·메일은 저장소 설정(src/lib/site-config.ts), 메일은 빌드 변수가 먼저.
import Logo from './Logo.astro';
import VisitCount from './VisitCount.astro';
import { ko } from '../copy/ko.ts';
import { withCommas } from '../lib/catalog/core.ts';
import { CONTACT_EMAIL } from '../lib/feedback.ts';
import { ROUTES } from '../lib/routes.ts';
import { SITE_CONFIG } from '../lib/site-config.ts';
import { STAGE } from '../lib/stage.ts';
import { fill } from '../lib/text.ts';

interface Props {
  fetched: string;
  total: number;
}
const { fetched, total } = Astro.props;
const F = ko.footer;
const email = CONTACT_EMAIL || SITE_CONFIG.email;
---

<footer class="site-footer">
  <div class="ft-inner">
    <Logo height={28} class="ft-logo" />
    <nav aria-label={F.label}>
      <ul class="ft-links">
        <li><a href={ROUTES.legalTerms}>{F.legalTerms}</a></li>
        <li><a class="ft-strong" href={ROUTES.privacy}>{F.privacy}</a></li>
        <li><a href={ROUTES.notice}>{F.notice}</a></li>
        <li><a href={ROUTES.copyright}>{F.copyrightLink}</a></li>
        <li><a href={ROUTES.credits}>{F.credits}</a></li>
        <li><a href={ROUTES.about}>{F.about}</a></li>
        <li><a href={ROUTES.terms}>{F.glossary}</a></li>
      </ul>
    </nav>
    <p class="ft-line ft-operator">
      <span>{fill(F.operator, { name: SITE_CONFIG.operator })}</span>
      <span>{F.email} <a href={`mailto:${email}`}>{email}</a></span>
    </p>
    <p class="ft-line">{fill(F.fetched, { date: fetched, n: withCommas(total) })}</p>
    <p class="ft-line">{F.rights}</p>
    <p class="ft-line">{fill(F.copyright, { year: SITE_CONFIG.since })}</p>
    {STAGE === 'preview' && <p class="ft-line">{F.trial}</p>}
    <VisitCount />
  </div>
</footer>
