---
// 머리줄 (brief 3절): 로고 · 카테고리 메뉴 · 전체 검색창 · 이용 가이드 [?](O1, 600px 이상) · 찜(N1, 개수 배지는 src/lib/wish-buttons.ts) · 장바구니(담은 개수 배지, 누르면 오른쪽 서랍).
// 휴대폰(<600)은 메뉴 · 로고 · 검색 아이콘 · 찜 · 장바구니, 검색창은 /search 쪽에서 연다(이용 가이드는 카테고리 메뉴 아래와 바닥글에). 위에 붙어 따라온다.
// U (D148): 장바구니 링크도 정적 HTML이다(서랍 섬은 <dialog>만 그리고 이 링크를 붙잡는다). 두 배지는 Base.astro 머리의 작은 스크립트가
// 저장된 개수로 첫 그림 전에 채운다: 섬이 깨어날 때 배지가 나타나며 머리줄이 밀리지 않게.
import CartDrawer from './CartDrawer.tsx';
import CategoryMenu from './CategoryMenu.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { ko } from '../copy/ko.ts';
import type { NavCategory } from '../lib/catalog/types.ts';
import { ROUTES } from '../lib/routes.ts';
import { fill } from '../lib/text.ts';

interface Props {
  nav: NavCategory[];
  /** 검색 쪽에서 검색창에 미리 넣을 글 (빌드 때는 비어 있고 섬이 채운다) */
  query?: string;
}
const { nav, query = '' } = Astro.props;
---

<header class="site-header">
  <div class="hd-inner">
    <CategoryMenu nav={nav} />
    <a class="brand" href={ROUTES.home} aria-label={ko.layout.home}>
      <Logo height={36} />
    </a>
    <form class="hd-search" role="search" action={ROUTES.search} method="get">
      <label class="visually-hidden" for="hd-q">{ko.layout.searchLabel}</label>
      <input id="hd-q" name="q" type="search" value={query} placeholder={ko.layout.searchPlaceholder} enterkeyhint="search" autocomplete="off" />
      <button type="submit" class="hd-search-btn" aria-label={ko.layout.searchButton}>
        <Icon name="search" size="20px" />
      </button>
    </form>
    <a class="hd-search-link" href={ROUTES.search} aria-label={ko.layout.searchLabel}>
      <Icon name="search" size="24px" />
    </a>
    <button type="button" class="hd-help" data-tour-open aria-label={ko.layout.guide} title={ko.layout.guide}>
      <Icon name="help" size="24px" />
    </button>
    <a class="hd-wish" href={ROUTES.wishlist} data-wish-link data-label={ko.layout.wishCount} aria-label={ko.layout.wish}>
      <Icon name="heart" size="24px" />
      <span class="hd-cart-word">{ko.layout.wish}</span>
      <span class="hd-wish-n" data-n="0" aria-hidden="true">0</span>
    </a>
    <a class="hd-cart" href={ROUTES.cart} data-cart-link data-label={ko.layout.cartCount} aria-haspopup="dialog" aria-label={fill(ko.layout.cartCount, { n: 0 })}>
      <Icon name="cart" size="24px" />
      <span class="hd-cart-word">{ko.layout.cart}</span>
      <span class="hd-badge" data-n="0" aria-hidden="true">0</span>
    </a>
    <CartDrawer client:load nav={nav} />
  </div>
</header>

