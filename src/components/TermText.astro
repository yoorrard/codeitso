---
// 점선 밑줄 말 (brief 8절, glossary.md 5.7, D69): 설명 글 한 칸을 빌드 때 나눠 그린다 (실행 JS 0, 섬이 아니다).
// 설명 글 칸에만 쓴다: 제목·버튼·링크·라벨·code·붙여 넣을 말 상자·영수증·설계도 미리 보기·법 문서·홈 첫 화면·그림 설명(figcaption)에는 쓰지 않는다.
// 한 페이지에서 용어마다 처음 한 번, 8개까지, 한 칸에 2개까지 (term-site.ts가 Astro.locals로 센다). self는 그 카드 자신의 용어를 뺀다.
// 빌드 때는 글자 그대로인 <span class="term-mark">로 그린다: 자바스크립트가 꺼져 있으면 눌러도 아무 일이 없는 버튼이 Tab 순서에 남지 않게.
// 아래 작은 스크립트가 바로 <button popovertarget="term-pop">으로 바꿔 Tab으로 닿게 하고, 누르면 풀이 섬(TermPopover)이 연다.
// 섬이 깨어나기 전에 누른 것은 표시해 두었다가 섬이 깨어나면 연다.
import type { MarkSelf } from '../lib/term-site.ts';
import { markSegments } from '../lib/term-site.ts';

interface Props {
  text: string;
  self?: MarkSelf;
}
const { text, self } = Astro.props;
const parts = markSegments(Astro.locals ?? Astro.request, text, self);
---

{parts.map((p) => (typeof p === 'string' ? p : <span class="term-mark" data-term={p.id}>{p.text}</span>))}

<script>
  // 빌드 때 그린 밑줄 말 자리를 버튼으로 바꾼다 (모듈 스크립트라 문서를 다 읽은 뒤, 섬보다 먼저 돈다)
  for (const s of document.querySelectorAll<HTMLElement>('span.term-mark[data-term]')) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'term-mark';
    b.dataset['term'] = s.dataset['term'] ?? '';
    b.setAttribute('popovertarget', 'term-pop');
    b.textContent = s.textContent;
    s.replaceWith(b);
  }
  // 풀이 섬(client:idle)이 깨어나기 전(html[data-terms]가 없을 때) 누른 밑줄 말을 받아 둔다
  const root = document.documentElement;
  document.addEventListener('click', (e) => {
    if (root.hasAttribute('data-terms')) return;
    const mark = e.target instanceof Element ? e.target.closest('.term-mark') : null;
    if (!mark) return;
    e.preventDefault();
    for (const m of document.querySelectorAll('[data-term-wait]')) m.removeAttribute('data-term-wait');
    mark.setAttribute('data-term-wait', '');
  });
</script>
