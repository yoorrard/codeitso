---
// 글자 상표 '코드쇼퍼' = 소유자 로고의 글자(D60). 이름은 대체 글로 전한다. 낮·밤 두 벌은 src/lib/brand.ts.
import { ko } from '../copy/ko.ts';
import { NIGHT, WORDMARK, srcset } from '../lib/brand.ts';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<picture class:list={['wordmark', cls]}>
  <source media={NIGHT} srcset={srcset(WORDMARK.night1, WORDMARK.night2)} />
  <img src={WORDMARK.day1} srcset={srcset(WORDMARK.day1, WORDMARK.day2)} width={WORDMARK.width} height={WORDMARK.height} alt={ko.site.name} decoding="async" />
</picture>
