---
// 홈 출발 장면(M8 도착, M2 문 열기)의 장난감 택시. 오른쪽을 보는 옆모습, 화면에 바로 넣는 장식 그림.
// 움직일 조각: .car-body(차체), .car-door(뒷문, 왼쪽 가장자리가 경첩), .car-door-gap(문 안쪽 어둠), .wheel-back·.wheel-front(바퀴).
// 색은 토큰만: --navy, --navy-deep, --taxi, --sky, --gold-soft, --line.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg class:list={['car', cls]} viewBox="0 0 320 180" aria-hidden="true" focusable="false" fill="none" stroke="var(--navy-deep)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
  <ellipse cx="164" cy="166" rx="140" ry="7" fill="var(--navy-deep)" stroke="none" opacity=".18" />
  <g class="car-body">
    <rect x="124" y="12" width="48" height="22" rx="6" fill="var(--taxi)" />
    <path d="M141 16l-5 5 5 5M151 16l-4 10M155 16l5 5-5 5" stroke-width="3" />
    <path d="M40 138H284Q304 138 304 118V104Q304 90 288 89L240 86C230 58 216 30 190 30H106C82 30 70 52 60 86L34 88Q20 89 20 104V118Q20 138 40 138Z" fill="var(--navy)" />
    <path d="M22 100H302" stroke="var(--taxi)" stroke-width="6" stroke-linecap="butt" />
    <rect x="16" y="94" width="8" height="14" rx="3" fill="var(--taxi)" />
    <circle cx="296" cy="100" r="9" fill="var(--gold-soft)" />
    <path d="M42 138a30 30 0 0 1 60 0ZM226 138a30 30 0 0 1 60 0Z" fill="var(--navy-deep)" />
    <rect x="12" y="118" width="26" height="14" rx="7" fill="var(--line)" />
    <rect x="284" y="118" width="26" height="14" rx="7" fill="var(--line)" />
    <path d="M98 44H90Q80 52 74 76H98ZM166 44H200L218 76H166Z" fill="var(--sky)" />
    <path d="M158 38H198Q206 38 210 46L226 76Q228 80 228 88V120Q228 128 220 128H158" />
    <path d="M166 88h8" stroke="var(--line)" />
    <path d="M174 68l12-18" stroke="var(--card)" />
    <g class="car-door-gap">
      <rect x="104" y="38" width="54" height="90" rx="10" fill="var(--gold-soft)" />
      <path d="M128 126V80q0-8 8-8h10q6 0 6 6v48Z" fill="var(--navy)" stroke="none" />
    </g>
    <g class="car-door" style="transform-box: fill-box; transform-origin: left center">
      <rect x="104" y="38" width="54" height="90" rx="10" fill="var(--navy)" />
      <path d="M106 100h50" stroke="var(--taxi)" stroke-width="6" stroke-linecap="butt" />
      <rect x="110" y="44" width="42" height="32" rx="6" fill="var(--sky)" />
      <path d="M142 88h8" stroke="var(--line)" />
      <path d="M118 68l12-18" stroke="var(--card)" />
    </g>
  </g>
  <g class="wheel wheel-back" style="transform-box: fill-box; transform-origin: center">
    <circle cx="72" cy="141" r="25" fill="var(--navy-deep)" />
    <circle cx="72" cy="141" r="10" fill="var(--line)" />
    <path d="M66 141h12M72 135v12" stroke="var(--navy)" stroke-width="3" />
  </g>
  <g class="wheel wheel-front" style="transform-box: fill-box; transform-origin: center">
    <circle cx="256" cy="141" r="25" fill="var(--navy-deep)" />
    <circle cx="256" cy="141" r="10" fill="var(--line)" />
    <path d="M250 141h12M256 135v12" stroke="var(--navy)" stroke-width="3" />
  </g>
</svg>
