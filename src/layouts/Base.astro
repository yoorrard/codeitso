---
import { BRAND_FILES } from '../lib/brand-files.ts';
// 모든 화면의 기본 틀 (v5, brief 3절): 본문 바로 가기 → 머리줄(로고 · 카테고리 · 검색 · 찜 · 장바구니) → 본문 → 바닥글.
// 본문 맨 위에는 처음 화면 말고 모든 화면에 [뒤로]와 위치(crumbs)를 한 줄로 둔다 (N1, D137: src/lib/page-nav.ts).
// 화면 낭독기 알림 자리(#cc-live)와 어려운 말 풀이 섬(TermPopover), 맨 위로 단추도 여기 있다. 본문 폭은 최대 1440px (--container-max).
// 처음 방문 가이드(O1, D138)는 src/lib/tour.ts가 열 때만 받는다. 가이드가 쓰는 진열대 요약(대분류 이름·상품 수)은 <template id="tour-data">에 둔다.
import '../styles/global.css';
import '../styles/shop.css';
import '../styles/cart.css';
import '../styles/find.css';
import '../styles/nav.css';
import Icon from '../components/Icon.astro';
import { PageTop } from '../components/PageTop.tsx';
import type { Crumb } from '../components/PageTop.tsx';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TermPopover from '../components/TermPopover.tsx';
import { ko } from '../copy/ko.ts';
import { LIVE_ID } from '../lib/announce.ts';
import { withCommas } from '../lib/catalog/core.ts';
import { navData, site, totalItems } from '../lib/catalog/site.ts';
import { FILES, ROUTES, absoluteUrl, stripBase } from '../lib/routes.ts';
import { analyticsAllowed, BEACON_TOKEN, STAGE } from '../lib/stage.ts';

interface Props {
  /** 페이지 제목 (사이트 이름은 뒤에 붙는다). 없으면 홈 제목 */
  title?: string;
  description?: string;
  /** 검색 쪽: 머리줄 검색창 글 */
  query?: string;
  /** 읽는 글 폭(소개·처리방침)으로 줄인다 */
  read?: boolean;
  /** 위치: 이 화면까지 거쳐 온 위 단계들 (지금 화면은 빼고). 마지막 것이 [뒤로]의 기본 행선지 */
  crumbs?: Crumb[];
  /** [뒤로]가 이전 화면이 없을 때 갈 곳. 없으면 위치의 마지막 단계 → 처음 화면. false면 쪽이 직접 그린다(상세 섬) */
  back?: string | false;
  /** 이 쪽만 머리에 싣는 스타일 주소 (?url, 다른 쪽에서는 늦게 붙이는 것: /models의 표 스타일) */
  styles?: string[];
}
const { title, description = ko.site.description, query, read = false, crumbs = [], back, styles = [] } = Astro.props;
const fullTitle = title ? `${title} · ${ko.site.name}` : `${ko.site.name}: ${ko.site.slogan}`;
// 배포 서버는 끝 빗금을 뗀 주소로 맞춘다 (wrangler.jsonc html_handling, D50). 홈만 바탕 폴더 주소
const path = Astro.url.pathname.replace(/\/+$/, '');
const canonical = Astro.site ? new URL(stripBase(path || '/') === '/' ? ROUTES.home : path, Astro.site).href : undefined;
const ogImage = Astro.site ? absoluteUrl(Astro.site, `/${BRAND_FILES.og}`) : undefined;
const nav = navData();
const fetched = site().fetched;
const isHome = stripBase(path || '/') === '/';
const backHref = isHome || back === false ? null : (back ?? crumbs[crumbs.length - 1]?.href ?? ROUTES.home);
const tourCats = JSON.stringify(nav.map((c) => ({ id: c.id, name: c.name, total: withCommas(c.total) })));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" /><!-- floor-guard-ignore: meta theme-color는 CSS 변수를 읽지 못해 머리줄 바탕(--surface 낮) 값을 그대로 쓴다 -->
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111a2d" /><!-- floor-guard-ignore: meta theme-color는 CSS 변수를 읽지 못해 머리줄 바탕(--surface 밤) 값을 그대로 쓴다 -->
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={ko.site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <!-- 파비콘·앱 아이콘은 장바구니만 (D104, npm run logo). 주소는 바탕을 붙여 routes.ts FILES에서 -->
    <link rel="icon" href={FILES.favicon} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={FILES.icon192} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={FILES.appleTouchIcon} />
    <link rel="manifest" href={FILES.manifest} />
    {styles.map((href) => <link rel="stylesheet" href={href} />)}
    {STAGE === 'preview' && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // 첫 그림 전에: 사이트 설정의 '동작 줄이기', 목록 쪽 주소가 인기순 1쪽이 아니면 빌드 때 그린 카드를 뼈대로 덮는다(목록 섬이 바꿔 그린 뒤 푼다,
      // 섬이 4초 안에 깨어나지 못하면 그냥 푼다). 읽기만 한다 (저장은 src/lib/store.ts).
      try {
        var p = JSON.parse(localStorage.getItem('cc:prefs:v1') || '{}') || {};
        if (p.motion === 'reduce') document.documentElement.setAttribute('data-motion', 'reduce');
      } catch (e) {}
      // 출처 그림을 못 받으면(막힘·없어짐) 깨진 그림 대신 머리글자를 보이고, 받으면 살며시 드러낸다(U, D148: 판은 먼저, 그림은 다 받은 뒤).
      // 그림의 load·error는 거품이 일지 않아 잡기 단계에서 듣는다. 이 스크립트보다 먼저 받은 그림은 없지만, 혹시 몰라 문서를 다 읽으면 한 번 훑는다
      function ccThumb(t, cls) {
        var box = t && t.tagName === 'IMG' && t.closest ? t.closest('.thumb-img') : null;
        if (box) box.classList.add(cls);
      }
      document.addEventListener('error', function (e) { ccThumb(e.target, 'is-broken'); }, true);
      document.addEventListener('load', function (e) { ccThumb(e.target, 'is-loaded'); }, true);
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.thumb-img img').forEach(function (i) {
          if (i.complete) ccThumb(i, i.naturalWidth ? 'is-loaded' : 'is-broken');
        });
      });
      // 머리줄 장바구니·찜 배지를 저장된 개수로 첫 그림 전에 (U, D148): 그림 직전마다 부르는 requestAnimationFrame에서 머리줄이 읽혔는지 보고 채운다.
      // 섬·wish-buttons.ts가 깨어나면 같은 값으로 맞춘다 (배지가 늦게 나타나 머리줄이 밀리지 않게)
      (function badges() {
        var cart = document.querySelector('[data-cart-link]');
        if (!cart) {
          if (document.readyState === 'loading') requestAnimationFrame(badges);
          return;
        }
        [
          ['cc:cart:v1', cart, '.hd-badge'],
          ['cc:wish:v1', document.querySelector('[data-wish-link]'), '.hd-wish-n'],
        ].forEach(function (x) {
          try {
            var list = JSON.parse(localStorage.getItem(x[0]) || '[]');
            var n = Array.isArray(list) ? list.length : 0;
            var b = x[1] && x[1].querySelector(x[2]);
            if (!b || n === 0) return;
            b.setAttribute('data-n', String(n));
            b.textContent = n > 99 ? '99+' : String(n);
            x[1].setAttribute('aria-label', (x[1].getAttribute('data-label') || '').replace('{{n}}', String(n)));
          } catch (e) {}
        });
      })();
      // 소분류 목록 쪽 주소에 인기순 1쪽 말고 다른 것(정렬·쪽·거르기)이 있으면 빌드 때 그린 카드를 뼈대로 덮고,
      // 검색어가 있는 검색 쪽이면 섬이 뼈대·결과를 그릴 때까지 예시 칩을 가린다 (U, D148)
      if (
        (/\/c\/[^/]+\/[^/]+\/?$/.test(location.pathname) && location.search.replace(/[?&](sort=popular|page=1)(?=&|$)/g, '').length > 1) ||
        (/\/search\/?$/.test(location.pathname) && /[?&]q=[^&]/.test(location.search))
      ) {
        document.documentElement.setAttribute('data-list-pending', '');
        setTimeout(function () {
          // 섬이 깨어나 뼈대를 그리고 있으면 섬이 푼다
          if (!document.querySelector('.is-wait, .sk-set')) document.documentElement.removeAttribute('data-list-pending');
        }, 4000);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ko.layout.skip}</a>
    <SiteHeader nav={nav} query={query} />
    <main id="main" tabindex="-1" class:list={['page', { 'is-read': read }]}>
      <PageTop back={backHref} crumbs={crumbs} />
      <slot />
    </main>
    <button type="button" class="to-top" data-to-top hidden aria-label={ko.layout.toTop}>
      <Icon name="up" size="22px" />
    </button>
    <SiteFooter fetched={fetched} total={totalItems()} />
    <TermPopover client:idle />
    <template id="tour-data" data-cats={tourCats} data-total={withCommas(totalItems())}></template>
    <div id={LIVE_ID} class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
    {
      analyticsAllowed(Astro.url.pathname) && (
        <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: BEACON_TOKEN })}></script><!-- floor-guard-ignore: 쿠키 없는 Cloudflare Web Analytics, CLAUDE.md 꼭 지킬 것 1의 허용 예외(R-61). 토큰이 있을 때만, 장바구니 쪽 제외 -->
      )
    }
    <script>
      // [담기] 버튼 (src/lib/cart-buttons.ts), 찜 하트 (wish-buttons.ts), 뒤로·'/' 키·맨 위로 (page-nav.ts), 폰트 견본 (src/lib/font-preview.ts),
      // 이용 가이드 (tour.ts: 처음 한 번 저절로, [이용 가이드] 단추로 다시), 카테고리 메뉴 닫기 (Esc·바깥 누르기, 닫으면 단추로 초점)
      import { wireAddButtons } from '../lib/cart-buttons.ts';
      import { CARDS_EVENT } from '../lib/cart-ui.ts';
      import { watchFonts } from '../lib/font-preview.ts';
      import { outsidePress } from '../lib/overlay.ts';
      import { wirePageNav } from '../lib/page-nav.ts';
      import { wireTour } from '../lib/tour.ts';
      import { wireWishButtons } from '../lib/wish-buttons.ts';

      wireAddButtons();
      wireWishButtons();
      wirePageNav();
      wireTour();
      // 폰트 카드 견본 글꼴: 보일 때 받는다. 섬이 카드를 새로 그리면 다시 훑는다
      watchFonts();
      document.addEventListener(CARDS_EVENT, () => watchFonts());
      const menu = document.querySelector<HTMLDetailsElement>('details[data-menu]');
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      // 바깥 누르기: 메뉴 밖에서 누르고 뗀 때만 닫는다 (메뉴 안에서 끌다 밖에서 놓으면 그대로, src/lib/overlay.ts)
      if (menu) {
        const press = outsidePress(
          (e) => e.target instanceof Node && menu.contains(e.target),
          () => {
            if (menu.open) menu.open = false;
          },
        );
        // 거품 단계에서 듣는다: 위 겹(풀이 상자)이 잡기 단계에서 이 누르기를 썼는지(claimPress) 먼저 적은 뒤에 본다
        document.addEventListener('pointerdown', press.down);
        document.addEventListener('click', press.click);
      }
    </script>
  </body>
</html>
