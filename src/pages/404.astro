---
// 404 (T17): 길을 잘못 든 차. 홈 버튼.
import Base from '../layouts/Base.astro';
import Car from '../components/scene/Car.astro';
import { ko } from '../copy/ko.ts';
---

<Base title={ko.notFound.pageTitle}>
  <section class="lost">
    <div class="lost-car" aria-hidden="true"><Car /></div>
    <h1>{ko.notFound.title}</h1>
    <p class="lead">{ko.notFound.body}</p>
    <a class="btn btn-primary" href="/">{ko.notFound.home}</a>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  /* 길을 잘못 든 차: 살짝 기울고 뒤집힌 방향 */
  .lost-car {
    inline-size: min(70%, 260px);
    transform: scaleX(-1) rotate(-8deg);
  }
</style>
