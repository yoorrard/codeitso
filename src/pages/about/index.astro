---
// 소개 /about: 무엇을 하나 · 하지 않는 것 · 자료는 어디서 오나 · (연락 주소가 있으면) 틀린 곳 알리기.
import Base from '../../layouts/Base.astro';
import { ko } from '../../copy/ko.ts';
import { CONTACT_EMAIL, mailtoFor } from '../../lib/feedback.ts';
import { ROUTES } from '../../lib/routes.ts';
import { HOST } from '../../lib/stage.ts';

const A = ko.about;
const notBody = [...A.notBody, HOST === 'static' ? A.storedStatic : A.stored];
const mailto = CONTACT_EMAIL ? mailtoFor({ email: CONTACT_EMAIL, subject: ko.feedback.subject, lines: [ko.feedback.reportLine] }) : '';
---

<Base title={A.pageTitle} read>
  <article class="prose">
    <h1>{A.title}</h1>
    <h2>{A.what}</h2>
    {A.whatBody.map((t) => <p>{t}</p>)}
    <h2>{A.not}</h2>
    <ul>{notBody.map((t) => <li>{t}</li>)}</ul>
    <h2>{A.data}</h2>
    {A.dataBody.map((t) => <p>{t}</p>)}
    {
      mailto && (
        <>
          <h2>{A.report}</h2>
          <p>{A.reportBody}</p>
          <p>
            <a class="btn" href={mailto}>
              {ko.feedback.send}
            </a>
          </p>
        </>
      )
    }
    <p><a href={ROUTES.credits}>{A.creditsLink}</a></p>
  </article>
</Base>
