---
// 장바구니 /cart (brief 3절): 담은 재료(대분류별, 메모 고치기·빼기), 만들 앱 한 줄, 설치 명령 한꺼번에 복사, 공유 링크, 담은 재료 요약과 [프롬프트 뽑기].
// 공유 링크(/cart#s=…)로 열면 위에 공유받은 목록과 [모두 담기]. 방문 통계를 싣지 않는 쪽이다 (stage.ts analyticsAllowed).
import Base from '../layouts/Base.astro';
import CartPage from '../components/CartPage.tsx';
import { ko } from '../copy/ko.ts';
import { navData } from '../lib/catalog/site.ts';
---

<Base title={ko.cart.pageTitle}>
  <header class="list-head">
    <h1>{ko.cart.title}</h1>
  </header>
  <CartPage client:load nav={navData()} />
</Base>
