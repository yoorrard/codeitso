---
// 3단계 도구끼리 맞춰 보기 /check (brief 6.7, D70, v4 D98): 두 칸 격자의 왼쪽 칸 = 맞춰 보기 섬 → 왼쪽 칸 아래(상태 한 줄 +
// 주 버튼 [설계도 받으러 출발하기], 막힌 곳이 있으면 꺼짐 + 상태 한 줄이 까닭). 오른쪽 칸은 기본 틀의 설계도 창.
// 빌드 때는 처음 온 사람 기준이라 잠김(빈 상태 + [만들 앱 정하러 가기])을 그린다.
import Base from '../layouts/Base.astro';
import Check from '../components/Check.tsx';
import IssueButton from '../components/IssueButton.tsx';
import { ko } from '../copy/ko.ts';
import '../styles/check.css';
---

<Base title={ko.check.pageTitle} stage="check">
  <div class="in-pane">
    <Check client:load />
  </div>
  <IssueButton client:load slot="action" />
</Base>
