---
// 미리 짠 코스 /courses (docs/CONCEPT.md 6.10, T14, R-47): 완성 세트 카드 목록. 난이도·예상 시간은 레시피의 답·장바구니·그대로 둔 충돌로
// 엔진을 돌려 영수증과 같은 값(receiptModel: 1차 난이도와 그 말, 예상 시간)을 빌드 때 보여 준다.
// "이 레시피로 출발"(RecipeStart 섬)은 답·장바구니·그대로 둔 충돌·한 줄 입력을 채우고 재확인으로 간다.
import Base from '../layouts/Base.astro';
import '../styles/catalog-pages.css';
import RecipeStart from '../components/RecipeStart.tsx';
import { ko } from '../copy/ko.ts';
import { ROUTES, toolPath } from '../lib/routes.ts';
import { catalog, data } from '../lib/data.ts';
import { evaluate, receiptModel } from '../lib/engine/index.ts';

const R = ko.recipes;
const cards = data.recipes.recipes.map((recipe) => {
  const result = evaluate(catalog, { answers: recipe.answers, cart: recipe.cart, kept: recipe.kept ?? [] });
  // 발행 시각은 쓰지 않으므로 비워 둔다
  const model = receiptModel(catalog, result, '');
  const products = recipe.cart.map((id) => catalog.product.get(id)).filter((p) => p !== undefined);
  return { recipe, model, products };
});
---

<Base title={R.pageTitle} description={R.description}>
  <h1>{R.title}</h1>
  <p class="lead">{R.lead}</p>
  <ul class="card-list recipe-list">
    {
      cards.map(({ recipe, model, products }) => (
        <li class="card recipe-card" id={recipe.id}>
          <h2>{recipe.title}</h2>
          <p class="meta">
            {ko.home.recipeFor}: {recipe.forWho}
          </p>
          <p>{recipe.summary}</p>
          <dl class="recipe-facts">
            <dt>{R.cart}</dt>
            <dd>
              <ul class="link-list">
                {products.map((p) => (
                  <li>{p.layer === 'shelf' ? <a href={toolPath(p.id)}>{p.name}</a> : p.name}</li>
                ))}
              </ul>
            </dd>
            <dt>{model.difficultyLabel}</dt>
            <dd>{model.difficultyText}</dd>
            <dt>{model.timeLabel}</dt>
            <dd>{model.timeText}</dd>
          </dl>
          <RecipeStart client:visible recipeId={recipe.id} />
        </li>
      ))
    }
  </ul>
  <p class="recipe-own">{R.ownWay}</p>
  <a slot="action" class="btn" href={ROUTES.destination}>{R.goInterview}</a>
</Base>
