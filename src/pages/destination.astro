---
// 1단계 만들 앱 정하기 /destination (brief 6.5, D70, v4 D98): 두 칸 격자의 왼쪽 칸 = 질문 섬 → 왼쪽 칸 아래(상태 한 줄 + [이전] + 주 버튼).
// 오른쪽 칸은 기본 틀의 설계도 창. 빌드 때는 처음 온 사람 기준 첫 질문을 그린다.
import Base from '../layouts/Base.astro';
import Interview from '../components/Interview.tsx';
import InterviewAction from '../components/InterviewAction.tsx';
import { ko } from '../copy/ko.ts';
import '../styles/destination.css';
---

<Base title={ko.interview.pageTitle} stage="destination">
  <div class="in-pane q-sheet">
    <Interview client:load />
  </div>
  <InterviewAction client:load slot="action" />
</Base>
