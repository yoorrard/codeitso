---
// 홈 (brief 3절): 한 줄 소개 + 검색 → 대분류 타일(상품 수·소분류 몇 개) → 기획전 여섯 줄(가로로 넘기는 카드).
// PC 첫 화면(1440×900)에 검색·카테고리·기획전 첫 줄이 다 보이게 위를 낮게 둔다.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ProductCard } from '../components/ProductCard.tsx';
import { ko } from '../copy/ko.ts';
import { withCommas } from '../lib/catalog/core.ts';
import { categories, homeRows } from '../lib/catalog/site.ts';
import { CATEGORY_ICON } from '../lib/icons.ts';
import { ROUTES, categoryPath, listPath } from '../lib/routes.ts';
import { fill } from '../lib/text.ts';

const cats = categories();
const rows = homeRows();
---

<Base>
  <section class="hero" aria-labelledby="home-title">
    <h1 id="home-title" class="hero-title">{ko.site.slogan}</h1>
    <p class="hero-intro">{ko.site.intro}</p>
    <form class="hero-search" role="search" action={ROUTES.search} method="get">
      <label class="visually-hidden" for="home-q">{ko.layout.searchLabel}</label>
      <input id="home-q" name="q" type="search" placeholder={ko.layout.searchPlaceholder} enterkeyhint="search" autocomplete="off" />
      <button type="submit" class="btn btn-primary">
        <Icon name="search" size="20px" />
        <span>{ko.layout.searchButton}</span>
      </button>
    </form>
  </section>

  <section class="sec" aria-labelledby="cats-title">
    <h2 id="cats-title" class="visually-hidden">{ko.home.categoriesTitle}</h2>
    <ul class="cat-tiles">
      {
        cats.map((c) => (
          <li class="cat-tile" data-cat={c.id}>
            <a class="cat-tile-link" href={categoryPath(c.id)}>
              <span class="cat-dot" aria-hidden="true">
                <Icon name={CATEGORY_ICON[c.id]} size="22px" />
              </span>
              <span class="cat-tile-name">{c.nameKo}</span>
              <span class="cat-tile-n">{fill(ko.home.count, { n: withCommas(c.total) })}</span>
              <span class="cat-tile-desc">{ko.categories[c.id]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    rows.map((r) => (
      <section class="sec row" aria-labelledby={`row-${r.id}`}>
        <div class="sec-head">
          <h2 id={`row-${r.id}`}>{ko.home.rows[r.id]}</h2>
          {r.more && (
            <a class="sec-more" href={listPath(r.more.cat, r.more.sub)} aria-label={fill(ko.home.moreOf, { title: ko.home.rows[r.id] })}>
              {ko.home.more}
              <Icon name="chevron" size="16px" />
            </a>
          )}
        </div>
        <ul class="row-track">
          {r.cards.map((c, i) => (
            <li>
              <ProductCard card={c} slot={`${r.id}${i}`} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
