---
// 홈 / (v4 D96·D98): 지도·첫 방문 장면 없이 짧은 첫 화면. 1024px부터 두 칸: 왼쪽 = H1 + 한 줄 + 주 버튼과 묶음 목록(HomeStart 섬:
// 다시 온 손님은 [이어서 가기]와 '새로 만들 앱 정하기') + 믿음 줄, 오른쪽 = 미리 짠 코스 세 장. 그 아래 '이렇게 가요' 네 칸.
// 1440×900 첫 화면에 소개·주 버튼·코스 셋이 다 보인다 (tests/e2e/layout-v4.spec.ts). 코스 카드를 누르면 코스 미리 보기 시트가 뜨고
// 그 안의 [이 코스로 출발]이 주 버튼이다. 스크립트가 없으면 코스 카드는 코스 모음의 그 코스로 간다.
// 첫 화면 JS에는 엔진·자료가 없다: 코스로 채우는 모듈(src/lib/course.ts)은 [이 코스로 출발]을 누를 때,
// 이어 갈 곳(src/lib/continue.ts)은 저장된 진행이 있을 때만 늦게 불러온다.
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import HomeStart from '../components/HomeStart.tsx';
import Icon from '../components/Icon.astro';
import { ko } from '../copy/ko.ts';
import { catalog, data } from '../lib/data.ts';
import { evaluate, fill, receiptModel } from '../lib/engine/index.ts';
import { glyph } from '../lib/glyphs.ts';
import { iconSvg } from '../lib/icons.ts';
import { ROUTES } from '../lib/routes.ts';
import { shelfProducts } from '../lib/shelf.ts';
import { NUMBERED } from '../lib/stages.ts';

const H = ko.home;
const courses = data.recipes.recipes.slice(0, 3).map((recipe) => {
  const result = evaluate(catalog, { answers: recipe.answers, cart: recipe.cart, kept: recipe.kept ?? [] });
  // 난이도·예상 시간은 영수증과 같은 값 (발행 시각은 쓰지 않으므로 비워 둔다)
  const model = receiptModel(catalog, result, '');
  const tools = recipe.cart.map((id) => catalog.product.get(id)?.name).filter((n) => n !== undefined);
  return {
    recipe,
    model,
    tools,
    // '교사, 학생회' → '교사·학생회': 줄 안의 ' · '와 나뉘게
    sub: fill(H.recipeSub, { who: recipe.forWho.replace(/,\s*/g, '·'), time: model.timeText, level: model.difficultyText }),
  };
});

const icons = {
  practice: glyph('q-ai-chat-free'),
  tools: glyph('q-domain-none'),
  fresh: iconSvg('pin', '20px'),
};
---

<Base width="wide">
  <div class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <h1 id="home-title" class="t-display" tabindex="-1">{H.title}</h1>
      <p class="home-intro">{H.intro}</p>
      <HomeStart client:load icons={icons} toolsSub={fill(H.browseSub, { n: shelfProducts.length })} />
      <p class="home-note">{H.trust}</p>
    </section>

    <section class="home-courses-sec" aria-labelledby="home-courses">
      <div class="home-section-head">
        <h2 id="home-courses" class="t-title-3">{H.recipesTitle}</h2>
        <a class="btn btn-text" href={ROUTES.courses} aria-label={H.allRecipesLabel}>{H.allRecipes}</a>
      </div>
      <ul class="home-courses">
        {
          courses.map(({ recipe, sub, tools }) => (
            <li>
              <a class="course-card" href={`${ROUTES.courses}#${recipe.id}`} data-course={recipe.id} aria-haspopup="dialog">
                <span class="course-card-name">{recipe.title}</span>
                <span class="course-card-sub">{sub}</span>
                <span class="course-card-tools">{tools.join(' · ')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="home-how-sec" aria-labelledby="home-how">
      <h2 id="home-how" class="t-title-3">{H.howTitle}</h2>
      <ol class="home-how">
        {
          NUMBERED.map((s, i) => (
            <li>
              <span class="num-dot" aria-hidden="true">
                {i + 1}
              </span>
              <span class="home-how-text">
                <span class="home-how-name">{ko.stages[s.id]}</span>
                <span class="home-how-sub">{H.how[s.id as keyof typeof H.how]}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  {
    courses.map(({ recipe, model, tools }) => (
      <dialog class="modal course-sheet" id={`course-${recipe.id}`} aria-labelledby={`course-${recipe.id}-title`}>
        <div class="modal-head">
          <h2 class="modal-title" id={`course-${recipe.id}-title`}>
            {recipe.title}
          </h2>
          <form method="dialog">
            <button class="icon-btn" aria-label={H.close}>
              <Icon name="close" />
            </button>
          </form>
        </div>
        <p class="course-summary">{recipe.summary}</p>
        <dl class="course-facts">
          <div>
            <dt>{H.recipeFor}</dt>
            <dd>{recipe.forWho}</dd>
          </div>
          <div>
            <dt>{H.recipeCart}</dt>
            <dd>{tools.join(', ')}</dd>
          </div>
          <div>
            <dt>{model.difficultyLabel}</dt>
            <dd>{model.difficultyText}</dd>
          </div>
          <div>
            <dt>{model.timeLabel}</dt>
            <dd>{model.timeText}</dd>
          </div>
        </dl>
        <p class="course-note">{H.recipesLead}</p>
        <button type="button" class="btn btn-primary btn-lg btn-block course-go" data-course-go={recipe.id} aria-label={fill(H.recipeGoLabel, { title: recipe.title })}>
          {H.recipeGo}
        </button>
      </dialog>
    ))
  }
  <dialog class="sheet" id="course-overwrite" aria-labelledby="course-overwrite-title" aria-describedby="course-overwrite-body">
    <h2 id="course-overwrite-title">{H.overwriteTitle}</h2>
    <p id="course-overwrite-body">{H.overwriteBody}</p>
    <form method="dialog" class="sheet-actions">
      <button class="btn">{H.overwriteNo}</button>
      <button class="btn btn-danger" value="go" data-course-confirm>{H.overwriteYes}</button>
    </form>
  </dialog>
</Base>

<script>
  // 코스 카드를 누르면 미리 보기 시트를 연다 (스크립트가 없으면 링크대로 코스 모음의 그 코스로 간다).
  // 닫으면 누른 줄로 초점을 돌리고, 뒤 막을 누르면 닫는다.
  // [이 코스로 출발]은 코스로 채우는 모듈을 그때 불러온다(엔진·자료를 첫 화면 JS에 넣지 않는다). 저장된 진행을 덮어쓰면 먼저 묻는다.
  import type { Session } from '../lib/engine/types.ts';

  const closeOnBackdrop = (d: HTMLDialogElement): void => {
    d.addEventListener('click', (e) => {
      if (e.target !== d) return;
      const box = d.getBoundingClientRect();
      if (e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom) d.close();
    });
  };

  for (const row of document.querySelectorAll<HTMLAnchorElement>('a[data-course]')) {
    const sheet = document.getElementById(`course-${row.dataset.course ?? ''}`);
    if (!(sheet instanceof HTMLDialogElement) || typeof sheet.showModal !== 'function') continue;
    row.addEventListener('click', (e) => {
      e.preventDefault();
      sheet.showModal();
    });
    sheet.addEventListener('close', () => row.focus());
    closeOnBackdrop(sheet);
  }

  const overwrite = document.getElementById('course-overwrite');
  let pending: { target: Session; from: HTMLButtonElement } | null = null;
  if (overwrite instanceof HTMLDialogElement) {
    closeOnBackdrop(overwrite);
    overwrite.addEventListener('close', () => {
      if (overwrite.returnValue !== 'go') pending?.from.focus();
    });
    overwrite.querySelector('[data-course-confirm]')?.addEventListener('click', () => {
      const p = pending;
      if (p) void import('../lib/course.ts').then((m) => m.startCourse(p.target));
    });
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('button[data-course-go]')) {
    btn.addEventListener('click', () => {
      void import('../lib/course.ts').then((m) => {
        const target = m.courseSession(btn.dataset.courseGo ?? '');
        if (!target) return;
        if (m.wouldOverwrite(target) && overwrite instanceof HTMLDialogElement) {
          pending = { target, from: btn };
          overwrite.returnValue = '';
          overwrite.showModal();
        } else m.startCourse(target);
      });
    });
  }
</script>
