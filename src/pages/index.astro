---
// 홈 / (docs/CONCEPT.md 6.1): '요금 0원' 칩, 제목, 소개, 주 버튼 '만들 앱 정하기', 하는 일 한 줄, 도구 둘러보기·내 AI 써 보기 권유, 믿음 줄,
// 다시 온 손님의 '이어서 가기', 미리 짠 코스. 위쪽 지도와 배차 장면(S1)은 지도 작업(T28·T29)에서 더한다.
import Base from '../layouts/Base.astro';
import HomeContinue from '../components/HomeContinue.tsx';
import RecipeStart from '../components/RecipeStart.tsx';
import { ko } from '../copy/ko.ts';
import { data } from '../lib/data.ts';
import { ROUTES } from '../lib/routes.ts';

const H = ko.home;
const recipes = data.recipes.recipes.slice(0, 3);
---

<Base>
  <section class="hero" aria-labelledby="home-title">
    <p class="fare-chip">
      <span class="fare-dot" aria-hidden="true"></span>
      {H.fareChip}
    </p>
    <h1 id="home-title" tabindex="-1">{H.title}</h1>
    <p class="lead">{H.intro}</p>
    <a class="btn btn-primary btn-lg go" href={ROUTES.destination}>{H.build}</a>
    <p class="explain">{H.explain}</p>
    <div class="secondary">
      <a class="btn" href={ROUTES.tools}>{H.browse}</a>
      <p class="invite">
        {H.lessonInvite} <a href={ROUTES.testDrive}>{H.lessonGo}</a>
      </p>
    </div>
    <p class="trust">{H.trust}</p>
  </section>

  <HomeContinue client:idle />

  <section class="recipes" aria-labelledby="home-recipes">
    <h2 id="home-recipes">{H.recipesTitle}</h2>
    <p>{H.recipesLead}</p>
    <ul class="card-list">
      {
        recipes.map((r) => (
          <li class="card">
            <h3>{r.title}</h3>
            <p class="meta">
              {H.recipeFor}: {r.forWho}
            </p>
            <p>{r.summary}</p>
            <RecipeStart client:visible recipeId={r.id} />
          </li>
        ))
      }
    </ul>
    <p><a href={ROUTES.courses}>{H.allRecipes}</a></p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .hero h1 {
    font-size: var(--text-2xl);
  }

  .hero h1:focus {
    outline: none;
  }

  .go {
    justify-self: stretch;
  }

  .btn-lg {
    min-block-size: 56px;
    font-size: var(--text-lg);
  }

  .explain,
  .invite,
  .trust {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .secondary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .recipes h2 {
    font-size: var(--text-xl);
  }

  @media (min-width: 768px) {
    .go {
      justify-self: start;
      min-inline-size: 320px;
    }
  }
</style>
