---
// 인터뷰 /interview (docs/UX.md 3.3, T08): 질문 섬 하나. 빌드 때는 처음 온 사람 기준 첫 질문을 그린다.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Interview from '../components/Interview.tsx';
import face from '../assets/mascot/chauffeur-face.png';
import { ko } from '../copy/ko.ts';

const faceImg = await getImage({ src: face, width: 80, height: 80, format: 'webp' });
---

<Base title={ko.interview.pageTitle} station="interview">
  <Interview client:load faceSrc={faceImg.src} />
  <a slot="action" class="btn" href="/shelf">{ko.interview.browseOnly}</a>
</Base>
