---
// 이용 안내 초안 /legal/notice (R-73·R-74, T17). 정식 출시 전 사람이 최종 문구를 확인한다 (docs/HUMAN.md H04).
import Base from '../../layouts/Base.astro';
import { ko } from '../../copy/ko.ts';

const L = ko.legal;
---

<Base title={L.noticeTitle}>
  <article class="prose">
    <p class="review-banner" role="note">{L.reviewing}</p>
    <h1>{L.noticeTitle}</h1>
    {
      L.notice.map((x) => (
        <>
          <h2>{x.h}</h2>
          <p>{x.p}</p>
        </>
      ))
    }
  </article>
</Base>
