---
// 개인정보 처리방침 초안 /legal/privacy (R-74). v5: 미리 보기 그림·글꼴을 출처에서 불러오는 묶음을 더했다 (brief 5절). 정식 출시 전 사람이 최종 문구를 확인한다 (docs/HUMAN.md H04).
// 정적 호스트(PUBLIC_HOST=static)는 집계·방문 통계가 없으므로 해당 묶음 본문을 ko.legal.privacyStatic으로 바꿔 낸다.
import Base from '../../layouts/Base.astro';
import { ko } from '../../copy/ko.ts';
import { HOST } from '../../lib/stage.ts';

const L = ko.legal;
// 서버 없는 정적 호스트면 익명 집계·방문 통계·맡기는 곳 묶음을 바꿔 끼운다 (설계서 9.4절)
const swap: Partial<Record<string, string>> = HOST === 'static' ? L.privacyStatic : {};
const items = L.privacy.map((x) => ({ h: x.h, p: swap[x.id] ?? x.p }));
---

<Base title={L.privacyTitle} read>
  <article class="prose">
    <p class="review-banner" role="note">{L.reviewing}</p>
    <h1>{L.privacyTitle}</h1>
    {
      items.map((x) => (
        <>
          <h2>{x.h}</h2>
          <p>{x.p}</p>
        </>
      ))
    }
  </article>
</Base>
