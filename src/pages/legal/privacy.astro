---
// 개인정보 처리방침 초안 /legal/privacy (R-74, T17). 정식 출시 전 사람이 최종 문구를 확인한다 (docs/HUMAN.md H04).
import Base from '../../layouts/Base.astro';
import { ko } from '../../copy/ko.ts';

const L = ko.legal;
---

<Base title={L.privacyTitle}>
  <article class="prose">
    <p class="review-banner" role="note">{L.reviewing}</p>
    <h1>{L.privacyTitle}</h1>
    {
      L.privacy.map((x) => (
        <>
          <h2>{x.h}</h2>
          <p>{x.p}</p>
        </>
      ))
    }
  </article>
</Base>
