---
// 장보기 /shop (docs/UX.md 3.4, T09): 칸 목록과 상품 섬 하나. 아래 막대는 재확인으로.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Shop from '../components/Shop.tsx';
import face from '../assets/mascot/chauffeur-face.png';
import { ko } from '../copy/ko.ts';

const faceImg = await getImage({ src: face, width: 80, height: 80, format: 'webp' });
---

<Base title={ko.shop.pageTitle} station="shop">
  <Shop client:load faceSrc={faceImg.src} />
  <a slot="action" class="btn btn-primary" href="/check">{ko.shop.goCheck}</a>
</Base>
