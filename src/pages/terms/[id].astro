---
// 용어 카드 /terms/[id] (docs/CONCEPT.md 6.8, T12): 검색으로도 들어오는 정적 페이지. 설명·그림 설명·문제 글은 HTML로,
// 문제 풀기·읽음·내 AI에게 배우기·해 보기만 섬이다.
import Base from '../../layouts/Base.astro';
import ConceptActions from '../../components/ConceptActions.tsx';
import TryIt from '../../components/TryIt.tsx';
import { ko } from '../../copy/ko.ts';
import { ROUTES, termPath, toolPath } from '../../lib/routes.ts';
import { catalog, data } from '../../lib/data.ts';
import type { Concept } from '../../lib/engine/types.ts';

export function getStaticPaths() {
  return data.concepts.concepts.map((c) => ({ params: { id: c.id }, props: { concept: c } }));
}

interface Props {
  concept: Concept;
}
const { concept: c } = Astro.props;
const prereqs = c.prerequisites.map((id) => catalog.concept.get(id)).filter((x) => x !== undefined);
const related = (c.relatedProducts ?? []).map((id) => catalog.product.get(id)).filter((x) => x !== undefined);
// 개념 그림 (svg-illustrator가 그린 src/assets/concepts/<id>.svg). 있으면 그림 + 설명, 없으면 설명 상자만 (D46)
const figures = import.meta.glob<string>('../../assets/concepts/*.svg', { query: '?raw', import: 'default', eager: true });
const figureSvg = figures[`../../assets/concepts/${c.id}.svg`];
---

<Base title={c.title} description={c.summary}>
  <article class="concept">
    <p><a href={ROUTES.terms}>{ko.concept.back}</a></p>
    <h1>{c.title}</h1>
    <p><span class={c.level === 'must' ? 'badge' : 'badge badge-soft'}>{ko.concept.level[c.level]}</span></p>
    {
      c.aliases && c.aliases.length > 0 && (
        <p class="q-help">
          {ko.concept.aliases}: {c.aliases.join(', ')}
        </p>
      )
    }
    <p class="concept-summary">{c.summary}</p>
    {
      c.figure && (
        <figure class={figureSvg ? 'concept-figure has-art' : 'concept-figure'}>
          {figureSvg && <div class="concept-art" role="img" aria-label={c.figure} set:html={figureSvg} />}
          <figcaption>
            <strong>{ko.concept.figure}</strong> {c.figure}
          </figcaption>
        </figure>
      )
    }
    {
      prereqs.length > 0 && (
        <p>
          {ko.concept.prerequisites}:{' '}
          {prereqs.map((p, i) => (
            <>
              {i > 0 && ', '}
              <a href={termPath(p.id)}>{p.title}</a>
            </>
          ))}
        </p>
      )
    }
    {
      c.tryIt && (
        <section class="card" aria-labelledby="tryit-title">
          <h2 id="tryit-title">{ko.concept.tryIt}</h2>
          <p>{c.tryIt.instruction}</p>
          <p class="q-help">{ko.concept.tryItNote}</p>
          <TryIt client:visible kind={c.tryIt.kind} />
        </section>
      )
    }
    <ConceptActions client:visible conceptId={c.id} quiz={c.quiz} askAI={c.askAI} />
    {
      related.length > 0 && (
        <section aria-labelledby="related-title">
          <h2 id="related-title">{ko.concept.related}</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={toolPath(p.id)}>{p.name}</a>: {p.summary}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
