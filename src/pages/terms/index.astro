---
// 용어 사전 /terms (v5): data/glossary.json의 용어를 묶음별로 한 쪽에. 용어마다 #id 자리가 있어 풀이 상자의 '용어 사전에서 보기'가 바로 온다.
import Base from '../../layouts/Base.astro';
import glossary from '../../../data/glossary.json';
import { ko } from '../../copy/ko.ts';
import { cmpText } from '../../lib/catalog/core.ts';
import type { GlossaryEntry } from '../../lib/glossary.ts';
import { fill } from '../../lib/text.ts';

/** 자료 파일을 import하면 kind가 string으로 읽힌다. 모양은 schemas/glossary.schema.json과 시험이 지킨다 */
const terms = glossary.terms as unknown as GlossaryEntry[];
const kinds = Object.keys(ko.terms.kinds).filter((k) => k !== 'site') as (keyof typeof ko.terms.kinds)[];
const groups = kinds.map((k) => ({ k, list: terms.filter((t) => t.kind === k).sort((a, b) => cmpText(a.term, b.term)) })).filter((g) => g.list.length > 0);
---

<Base title={ko.terms.pageTitle} read>
  <header class="list-head">
    <h1>{ko.terms.title}</h1>
    <p class="page-lead">{ko.terms.lead}</p>
    <p class="muted">{fill(ko.terms.count, { n: terms.length })}</p>
  </header>
  <nav class="sub-strip" aria-label={ko.terms.title}>
    <ul>
      {groups.map((g) => <li><a class="chip" href={`#kind-${g.k}`}>{ko.terms.kinds[g.k]}</a></li>)}
    </ul>
  </nav>
  {
    groups.map((g) => (
      <section class="sec" aria-labelledby={`kind-${g.k}`}>
        <h2 id={`kind-${g.k}`}>{ko.terms.kinds[g.k]}</h2>
        <dl class="term-list">
          {g.list.map((t) => (
            <div class="term-item" id={t.id}>
              <dt>
                {t.term}
                {t.say && <span class="term-say">{fill(ko.terms.say, { say: t.say })}</span>}
              </dt>
              <dd>
                <p>{t.plain}</p>
                {t.example && <p class="muted">{fill(ko.terms.example, { example: t.example })}</p>}
                {t.aliases && t.aliases.length > 0 && <p class="term-aliases">{fill(ko.terms.aliases, { names: t.aliases.join(', ') })}</p>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }
</Base>
