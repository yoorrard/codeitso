---
// 용어 카드 /terms (brief 6.10, D67 W3b): H1 26 + 한 줄 → "20장 중 n장 읽음" → (만들 앱을 정했으면) '읽어 둘 용어' 줄 목록
// → 2열 타일(640px 이상 4열). 타일 위 96은 옅은 판(--plate) 위 청사진 그림, 아래는 이름 16/600과 상태.
// 타일은 정적 HTML이고, 상태 글과 위 묶음은 StudyList 섬이 저장된 기록으로 채운다.
import Base from '../../layouts/Base.astro';
import '../../styles/catalog-pages.css';
import '../../styles/terms.css';
import StudyList from '../../components/StudyList.tsx';
import { ko } from '../../copy/ko.ts';
import { data } from '../../lib/data.ts';
import { termPath } from '../../lib/routes.ts';

// 필수부터, 같은 무리 안에서는 자료 순서대로
const all = [...data.concepts.concepts].sort((a, b) => (a.level === b.level ? a.order - b.order : a.level === 'must' ? -1 : 1));
// 개념 그림 (src/assets/concepts/<id>.svg, 판 색 변수로 칠한다)
const figures = import.meta.glob<string>('../../assets/concepts/*.svg', { query: '?raw', import: 'default', eager: true });
---

<Base title={ko.study.pageTitle}>
  <h1>{ko.study.title}</h1>
  <p class="page-lead">{ko.study.lead}</p>
  <StudyList client:load />
  <section class="sec" aria-labelledby="terms-all">
    <h2 id="terms-all" class="visually-hidden">{ko.study.title}</h2>
    <ul class="term-grid">
      {
        all.map((c) => {
          const svg = figures[`../../assets/concepts/${c.id}.svg`];
          return (
            <li>
              <a class="term-tile" href={termPath(c.id)}>
                <span class="plate term-plate" aria-hidden="true" set:html={svg ?? ''} />
                <span class="term-text">
                  <span class="term-name">{c.title}</span>
                  <span class="term-state visually-hidden" data-term-state={c.id}>
                    {ko.study.notRead}
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>
