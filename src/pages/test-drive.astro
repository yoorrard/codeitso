---
// 내 AI 써 보기 /test-drive (연습, 번호 밖. brief 6.4, D70, R-11·R-12): 내 AI 채팅에 문장 셋을 보내 웹페이지 한 장을 만든다.
// H1(기사가 묻는 말) + 한 줄 + 글 버튼 '건너뛰고 만들 앱 정하기'(건너뛰기는 주 버튼이 아니다) → 세로 번호 단계 셋
// (번호 원 24 + 2px 잇는 선. 단계마다 제목 19/600, 붙여 넣을 말 상자, 그다음 볼 것 한 줄, 접기 '잘 안 돼요') → 끝 한 줄.
// 아래 막대: 상태 한 줄 + [다 했어요] → 마치면 [만들 앱 정하러 가기] (LessonFinish 섬).
// 두 칸 격자의 왼쪽 칸 (v4 D98). 연습 고리 지도와 장면 S8은 걷어 냈다 (D96).
import Base from '../layouts/Base.astro';
import CopyButton from '../components/CopyButton.tsx';
import LessonFinish from '../components/LessonFinish.tsx';
import { Lead } from '../components/Lead.tsx';
import { ko } from '../copy/ko.ts';
import { fill } from '../lib/engine/index.ts';
import { ROUTES } from '../lib/routes.ts';
import '../styles/practice.css';

const L = ko.lesson;
---

<Base title={L.pageTitle} stage="test-drive">
  <div class="in-pane practice">
    <h1 id="practice-title" tabindex="-1">{L.title}</h1>
    <Lead text={L.lead} />
    <a class="btn btn-text practice-skip" href={ROUTES.destination}>{L.skip}</a>
    <ol class="practice-steps">
      {
        L.steps.map((step, i) => {
          const label = fill(L.stepLabel, { n: i + 1 });
          return (
            <li class="practice-step">
              <span class="num-dot practice-no" aria-hidden="true">
                {i + 1}
              </span>
              <div class="practice-body">
                <h2 class="practice-name" id={`practice-step-${i + 1}`}>
                  <span class="visually-hidden">{label} </span>
                  {step.title}
                  {step.pc && <span class="tag">{L.pc}</span>}
                </h2>
                <div class="paste">
                  <div class="paste-head">
                    <span class="paste-label">{L.pasteLabel}</span>
                    <CopyButton client:visible text={step.prompt} srLabel={`${label} ${step.title}: ${ko.common.copy}`} />
                  </div>
                  <p class="paste-body">{step.prompt}</p>
                </div>
                <p class="practice-after">{step.after}</p>
                <details class="fold practice-fold">
                  <summary>{L.stuck}</summary>
                  <ul>
                    {step.stuck.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </details>
              </div>
            </li>
          );
        })
      }
    </ol>
    <p class="practice-close">{L.closing}</p>
  </div>
  <LessonFinish client:load slot="action" />
</Base>
