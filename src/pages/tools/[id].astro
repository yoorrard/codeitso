---
// 도구 상세 /tools/[id] (brief 6.9, D67 W3b, R-46): 진열 도구만 정적으로 만든다 (색인 상품은 페이지가 없다).
// 머리(타일 64 + 이름 26 + 꼬리표 둘까지) → 한 줄 → (확인 중 알림) → 한눈에 보기(키-값 묶음) → 쓰기 전에 볼 것 → 막히기 쉬운 곳
// → 설계도에 들어갈 지시(붙여 넣을 말 상자) → 공식 문서(줄 56) → 이 도구가 들어간 코스 → 함께 보면 좋은 도구.
// 섬은 붙여 넣을 말 상자의 [복사] 하나뿐이다. 주 버튼은 아래 막대의 [만들 앱 정하기] 하나.
import Base from '../../layouts/Base.astro';
import '../../styles/catalog-pages.css';
import '../../styles/tools.css';
import Glyph from '../../components/Glyph.astro';
import Icon from '../../components/Icon.astro';
import CopyButton from '../../components/CopyButton.tsx';
import TermText from '../../components/TermText.astro';
import { ko } from '../../copy/ko.ts';
import { ROUTES, termPath, toolPath } from '../../lib/routes.ts';
import { catalog } from '../../lib/data.ts';
import { fill, toolDifficultyWord } from '../../lib/engine/index.ts';
import type { Product } from '../../lib/engine/index.ts';
import { capabilityLabel, domainLabel, productArt, recipesWith, shelfProducts } from '../../lib/shelf.ts';

export function getStaticPaths() {
  return shelfProducts.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const P = ko.product;
// 점선 밑줄 말을 긋는 칸 (brief 8절, D69): 한 줄·이럴 때 써요·비용·무료 한도·준비·막히기 쉬운 곳. 이 도구 자신의 이름은 빼고
const self = { tool: p.id };
const S = ko.shop;
const marked = new Set<string>([S.useWhen, S.cost, S.freeLimit]);
const T = catalog.data.templates;
const concepts = (p.needsConcepts ?? []).map((id) => catalog.concept.get(id)).filter((c) => c !== undefined);
const related = (p.related ?? []).map((id) => catalog.product.get(id)).filter((r) => r !== undefined);
const recipes = recipesWith(p.id);
const domains = (p.domains ?? []).map(domainLabel);
// 꼬리표는 둘까지, 모두 무채색 (brief 5.6: 색이 있는 꼬리표는 '추천' 하나). 비용은 한눈에 보기가 말한다
const tags = [
  p.provider.type === 'official' ? T.badges.official : null,
  p.realtime === 'realtime' ? T.badges.realtime : p.realtime === 'frequent' ? T.badges.frequent : null,
  p.difficulty === 1 ? T.badges.easy : null,
].filter((t) => t !== null).slice(0, 2);
// 한눈에 보기 (키-값)
const facts: { k: string; v: string }[] = [
  ...(p.useWhen ? [{ k: S.useWhen, v: p.useWhen }] : []),
  { k: S.cost, v: p.cost.note },
  ...(p.freeLimit ? [{ k: S.freeLimit, v: p.freeLimit }] : []),
  { k: S.difficulty, v: toolDifficultyWord(catalog, p.difficulty) },
  { k: P.capabilities, v: p.capabilities.map(capabilityLabel).join(', ') },
  ...(domains.length > 0 ? [{ k: P.domains, v: domains.join(', ') }] : []),
  { k: S.provider, v: `${p.provider.name} (${S.providerWords[p.provider.type]})` },
  { k: S.access, v: T.accessLabels[p.access] },
  ...(p.realtime ? [{ k: S.realtime, v: S.realtimeWords[p.realtime] }] : []),
];
// 확인한 때 '2026-10' → '2026년 10월' (모양이 다르면 그대로)
const ym = /^(\d{4})-(\d{2})/.exec(p.checkedAt);
// 사람 확인이 남은 도구는 '확인했어요'라고 쓰지 않는다 (맨 위 '확인 중' 알림과 어긋나지 않게)
const checked = fill(p.needsReview ? P.checkedDraft : P.checked, { date: ym ? fill(P.checkedMonth, { y: ym[1] ?? '', m: Number(ym[2]) }) : p.checkedAt });
---

<Base title={p.name} description={p.summary}>
  <a class="btn btn-text back-link" href={ROUTES.tools}>
    <Icon name="back" />
    <span>{P.back}</span>
  </a>
  <header class="tool-head">
    <Glyph name={productArt(p)} tile="xl" />
    <div class="tool-head-text">
      <h1>{p.name}</h1>
      {
        tags.length > 0 && (
          <ul class="tag-row">
            {tags.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
        )
      }
    </div>
  </header>
  <p class="page-lead"><TermText text={p.summary} self={self} /></p>
  <!-- 어려운 말 풀이 처음 한 번 기사 메시지 자리 (D69 검토 반영): 본문 흐름 안, 첫 그림 때부터 있는 알림 칸이라 화면을 가리지 않고 읽힌다 -->
  <div class="term-hint-slot" role="status" data-term-hint></div>
  {
    p.needsReview && (
      <p class="alert">
        <span class="alert-icon i-mask i-info" aria-hidden="true" />
        <span>
          <strong class="alert-title">{P.review}</strong> {P.reviewNote}
        </span>
      </p>
    )
  }

  <section class="sec" aria-labelledby="pd-facts">
    <h2 id="pd-facts" class="sec-title">{P.factsTitle}</h2>
    <dl class="kv group">
      {
        facts.map((f) => (
          <div class="kv-row">
            <dt>{f.k}</dt>
            <dd>{marked.has(f.k) ? <TermText text={f.v} self={self} /> : f.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="sec" aria-labelledby="pd-before">
    <h2 id="pd-before" class="sec-title">{P.detailsTitle}</h2>
    <dl class="kv group">
      <div class="kv-row">
        <dt>{S.keyRisk}</dt>
        <dd>{p.keyExposureRisk ? S.keyRiskYes : S.keyRiskNo}</dd>
      </div>
      {
        p.publicKey && (
          <div class="kv-row">
            <dt>{P.publicKey}</dt>
            <dd>{P.publicKeyNote}</dd>
          </div>
        )
      }
      {
        p.prep && p.prep.length > 0 && (
          <div class="kv-row">
            <dt>{P.prep}</dt>
            <dd>
              <ul>
                {p.prep.map((item) => {
                  const text = fill(P.prepLead, { label: item.label, lead: T.leadLabels[item.lead] });
                  return (
                    <li>
                      {item.url ? (
                        <a class="kv-link" href={item.url} target="_blank" rel="noopener noreferrer">
                          {text}
                          <span class="kv-ext i-mask i-external" aria-hidden="true" />
                          <span class="visually-hidden"> ({ko.shelf.newTab})</span>
                        </a>
                      ) : (
                        <TermText text={text} self={self} />
                      )}
                    </li>
                  );
                })}
              </ul>
            </dd>
          </div>
        )
      }
      {
        p.license && (
          <div class="kv-row">
            <dt>{S.license}</dt>
            <dd>
              {p.license.name}: {p.license.plain}
              {p.license.url && (
                <>
                  {' '}
                  <a class="kv-link" href={p.license.url} target="_blank" rel="noopener noreferrer">
                    {P.licenseLink}
                    <span class="kv-ext i-mask i-external" aria-hidden="true" />
                    <span class="visually-hidden"> ({ko.shelf.newTab})</span>
                  </a>
                </>
              )}
            </dd>
          </div>
        )
      }
      {
        concepts.length > 0 && (
          <div class="kv-row">
            <dt>{S.concepts}</dt>
            <dd>
              <ul class="chip-row kv-chips">
                {concepts.map((c) => (
                  <li>
                    <a class="chip" href={termPath(c.id)}>
                      {c.title}
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>
  </section>

  {
    p.stuck && p.stuck.length > 0 && (
      <section class="sec" aria-labelledby="pd-stuck">
        <h2 id="pd-stuck" class="sec-title">
          {S.stuck}
        </h2>
        <ul class="text-rows group">
          {p.stuck.map((t) => (
            <li>
              <TermText text={t} self={self} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    p.promptFragment && (
      <section class="sec" aria-labelledby="pd-fragment">
        <h2 id="pd-fragment" class="sec-title">
          {S.fragment}
        </h2>
        <p class="sec-note">{P.fragmentLead}</p>
        <div class="paste">
          <div class="paste-head">
            <span class="paste-label">{P.pasteLabel}</span>
            <CopyButton client:visible text={p.promptFragment} srLabel={`${S.fragment}: ${ko.common.copy}`} />
          </div>
          <p class="paste-body">{p.promptFragment}</p>
        </div>
      </section>
    )
  }

  <section class="sec" aria-labelledby="pd-links">
    <h2 id="pd-links" class="sec-title">{S.links}</h2>
    <ul class="list group">
      {
        p.links.map((l) => (
          <li>
            <a class="list-row" href={l.url} target="_blank" rel="noopener noreferrer">
              <span class="list-text">
                <span class="list-name">{l.label}</span>
              </span>
              <span class="list-ext" aria-hidden="true" />
              <span class="visually-hidden"> ({ko.shelf.newTab})</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="sec-foot">{checked}</p>
  </section>

  {
    recipes.length > 0 && (
      <section class="sec" aria-labelledby="pd-recipes">
        <h2 id="pd-recipes" class="sec-title">
          {P.recipesTitle}
        </h2>
        <ul class="list group">
          {recipes.map((r) => (
            <li>
              <a class="list-row is-tall" href={ROUTES.courses}>
                <span class="list-text">
                  <span class="list-name">{r.title}</span>
                  <span class="list-sub">{r.forWho}</span>
                </span>
                <span class="list-chev" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="sec" aria-labelledby="pd-related">
        <h2 id="pd-related" class="sec-title">
          {P.related}
        </h2>
        <ul class="list group">
          {related.map((r) => (
            <li>
              {r.layer === 'shelf' ? (
                <a class="list-row is-tall" href={toolPath(r.id)}>
                  <Glyph name={productArt(r)} tile="md" class="list-tile" />
                  <span class="list-text">
                    <span class="list-name">{r.name}</span>
                    <span class="list-sub is-one">{r.summary}</span>
                  </span>
                  <span class="list-chev" aria-hidden="true" />
                </a>
              ) : (
                <a class="list-row is-tall" href={r.links[0]?.url} target="_blank" rel="noopener noreferrer">
                  <Glyph name={productArt(r)} tile="md" class="list-tile" />
                  <span class="list-text">
                    <span class="list-name">{r.name}</span>
                    <span class="list-sub is-one">{r.summary}</span>
                  </span>
                  <span class="list-ext" aria-hidden="true" />
                  <span class="visually-hidden"> ({ko.shelf.newTab})</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div slot="action" class="bar-stack">
    <p class="bar-line">{ko.shelf.cartNote}</p>
    <a class="btn btn-primary" href={ROUTES.destination}>{ko.shelf.goBuild}</a>
  </div>
</Base>
