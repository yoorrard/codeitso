---
// 도구 모음 /tools (docs/CONCEPT.md 6.7, T13, R-46): 대표 기능별 도구 카드와 분야·기능 거르기 섬.
// 목록은 정적 HTML이라 자바스크립트 없이도 모두 보이고, 거르기 섬은 숨기기·보이기만 한다.
// 원문만 있는 도구는 상세 페이지 없이 맨 아래 '원문만 있는 도구'에만 보인다. 줄 목록 모양은 T32에서 바꾼다.
import Base from '../../layouts/Base.astro';
import '../../styles/catalog-pages.css';
import Glyph from '../../components/Glyph.astro';
import Icon from '../../components/Icon.astro';
import ShelfCard from '../../components/ShelfCard.astro';
import ShelfFilter from '../../components/ShelfFilter.tsx';
import { ko } from '../../copy/ko.ts';
import { ROUTES } from '../../lib/routes.ts';
import { DEFAULT_DOMAIN_ART, optionArt } from '../../lib/option-art.ts';
import { capabilityChoices, corners, domainChoices, indexProducts, shelfProducts } from '../../lib/shelf.ts';

const S = ko.shelf;
const everything = [...shelfProducts, ...indexProducts];
const groups = corners(shelfProducts);
---

<Base title={S.pageTitle} description={S.description}>
  <h1>{S.title}</h1>
  <p class="lead">{S.lead}</p>
  <p class="shelf-note">
    <Icon name="pin" />
    <span>{S.cartNote}</span>
  </p>
  <ShelfFilter
    client:idle
    domains={domainChoices(everything)}
    capabilities={capabilityChoices(everything)}
    generalArt={optionArt('q.domain', 'none') ?? DEFAULT_DOMAIN_ART}
    total={everything.length}
  />
  {
    groups.map((g) => (
      <section class="shelf-corner" data-shelf-group aria-labelledby={`corner-${g.capability}`}>
        <h2 id={`corner-${g.capability}`} class="corner-sign">
          <Glyph name={g.art} />
          <span>{g.label}</span>
        </h2>
        <ul class="card-list shelf-list">
          {g.products.map((p) => (
            <ShelfCard product={p} />
          ))}
        </ul>
      </section>
    ))
  }
  {
    indexProducts.length > 0 && (
      <section class="shelf-corner shelf-index" data-shelf-group aria-labelledby="corner-index">
        <h2 id="corner-index" class="corner-sign corner-sign-caution">
          <Icon name="warning" />
          <span>{S.indexTitle}</span>
        </h2>
        <p class="shelf-index-lead">{S.indexLead}</p>
        <ul class="card-list shelf-list">
          {indexProducts.map((p) => (
            <ShelfCard product={p} />
          ))}
        </ul>
      </section>
    )
  }
  <a slot="action" class="btn btn-primary" href={ROUTES.destination}>{S.goBuild}</a>
</Base>
