---
// 2단계 도구 고르기 /waypoints (docs/CONCEPT.md 6.4, T09): 고를 것 목록과 도구 섬 하나. 아래 막대는 도구끼리 맞춰 보기로.
import Base from '../layouts/Base.astro';
import MapBoard from '../components/MapBoard.tsx';
import Shop from '../components/Shop.tsx';
import { ko } from '../copy/ko.ts';
import { ROUTES } from '../lib/routes.ts';
---

<Base title={ko.shop.pageTitle} stage="waypoints">
  <div class="map-band is-waypoints"><MapBoard client:idle stage="waypoints" /></div>
  <Shop client:load />
  <a slot="action" class="btn btn-primary" href={ROUTES.check}>{ko.shop.goCheck}</a>
</Base>
