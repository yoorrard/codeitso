---
// 2단계 도구 고르기 /waypoints (brief 6.6, D70): 지도 띠 200(지금 여는 마디에 --you 고리) → 16 겹친 내용 시트 안의 도구 섬
// → 아래 막대(상태 한 줄 + 주 버튼 하나: [{도구}로 정하기] → 다 고르면 [도구끼리 맞춰 보러 가기]).
// 빌드 때는 처음 온 사람 기준이라 잠김(빈 상태 + [만들 앱 정하러 가기])을 그린다.
import Base from '../layouts/Base.astro';
import MapBoard from '../components/MapBoard.tsx';
import Shop from '../components/Shop.tsx';
import WaypointsAction from '../components/WaypointsAction.tsx';
import { ko } from '../copy/ko.ts';
import '../styles/waypoints.css';
---

<Base title={ko.shop.pageTitle} stage="waypoints">
  <div class="map-band is-waypoints"><MapBoard client:load stage="waypoints" /></div>
  <div class="content-sheet on-map">
    <Shop client:load />
  </div>
  <WaypointsAction client:load slot="action" />
</Base>
